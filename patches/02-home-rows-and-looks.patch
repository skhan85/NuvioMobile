+/**
+ * Fork: per-title freshness tags from TMDB, looked up a few at a time and kept for 12 hours.
+ */
+internal object ForkCardBadges {
+    /** `language`: original language when it isn't English ("Korean"), see [ForkLanguages.originalLabel]. */
+    data class Entry(val primary: String?, val secondary: String?, val atMs: Long, val language: String? = null)
+
+    private const val TTL_MS = 12 * 60 * 60 * 1000L
+    private const val KEEP_MS = 4 * TTL_MS
+    private const val STORE_KEY = "fork_card_badges_cache_v4"
+    private val entriesState = MutableStateFlow<Map<String, Entry>>(emptyMap())
+    val entries: StateFlow<Map<String, Entry>>
+        get() {
+            ensureLoaded()
+            return entriesState.asStateFlow()
+        }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val limiter = Semaphore(6)
+    private val inFlightMutex = Mutex()
+    private val inFlight = mutableSetOf<String>()
+    private var loaded = false
+    private var saveScheduled = false
+
+    private fun key(item: MetaPreview) = item.stableKey()
+
+    /** Tags saved by the last session: shown straight away, refreshed in the background when stale. */
+    private fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val raw = runCatching { ForkHomeSettingsStorage.loadForkString(STORE_KEY) }.getOrNull() ?: return
+        val now = Clock.System.now().toEpochMilliseconds()
+        val restored = raw.lineSequence().mapNotNull { line ->
+            val parts = line.split('\t')
+            if (parts.size != 5) return@mapNotNull null
+            val at = parts[3].toLongOrNull() ?: return@mapNotNull null
+            if (now - at > KEEP_MS) return@mapNotNull null
+            parts[0] to Entry(parts[1].ifEmpty { null }, parts[2].ifEmpty { null }, at, parts[4].ifEmpty { null })
+        }.toMap()
+        if (restored.isNotEmpty()) entriesState.update { restored + it }
+    }
+
+    private fun scheduleSave() {
+        if (saveScheduled) return
+        saveScheduled = true
+        scope.launch {
+            kotlinx.coroutines.delay(3_000)
+            saveScheduled = false
+            val now = Clock.System.now().toEpochMilliseconds()
+            val text = entriesState.value.entries
+                .filter { now - it.value.atMs <= KEEP_MS }
+                .sortedByDescending { it.value.atMs }
+                .take(2_500)
+                .joinToString("\n") { (k, e) ->
+                    listOf(k, e.primary.orEmpty(), e.secondary.orEmpty(), e.atMs.toString(), e.language.orEmpty()).joinToString("\t")
+                }
+            runCatching { ForkHomeSettingsStorage.saveForkString(STORE_KEY, text) }
+        }
+    }
+
+    fun request(item: MetaPreview) {
+        ensureLoaded()
+        val now = Clock.System.now().toEpochMilliseconds()
+        val cached = entriesState.value[key(item)]
+        if (cached != null && now - cached.atMs < TTL_MS) return
+        scope.launch {
+            val fresh = inFlightMutex.withLock { inFlight.add(key(item)) }
+            if (!fresh) return@launch
+            val result = limiter.withPermit {
+                runCatching { TmdbMetadataService.forkFreshness(item.id, item.type) }.getOrNull()
+            }
+            // Keep the saved tag when TMDB can't be reached rather than wiping it.
+            if (result != null || cached == null) {
+                val at = Clock.System.now().toEpochMilliseconds()
+                entriesState.update {
+                    it + (key(item) to Entry(result?.first, result?.second, at, ForkLanguages.originalLabel(result?.third)))
+                }
+                scheduleSave()
+            }
+            inFlightMutex.withLock { inFlight.remove(key(item)) }
+        }
+    }
+
+    /** Looks up tags for the start of every row as Home loads, so they're ready before you scroll. */
+    fun prefetch(sections: Collection<HomeCatalogSection>, perRow: Int = 15) {
+        val enabled = runCatching {
+            ForkHomeSettings.ensureLoaded()
+            ForkHomeSettings.cardBadges.value
+        }.getOrDefault(true)
+        if (!enabled) return
+        sections.forEach { section -> section.items.take(perRow).forEach(::request) }
+    }
+}
