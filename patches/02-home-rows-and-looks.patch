+package com.nuvio.app.features.home
+
+import androidx.compose.material3.ColorScheme
+import androidx.compose.ui.graphics.Color
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.ui.ThemeColorPalette
+import com.nuvio.app.core.ui.ThemeColors
+
+/**
+ * Fork: one look per profile (Settings > Homescreen > Style).
+ *
+ * Netflix Style is the default for every profile (Kids included); Custom changes nothing. Max Style and
+ * Disney+ Style were dropped on 2026-11-13: a saved Max or Disney+ choice, or the old Disney switch, reads as Netflix.
+ */
+enum class ForkStyle(val label: String, val summary: String) {
+    NETFLIX("Netflix Style", "Netflix's own #141414 Home with the billboard, Top 10, card tags and \"Continue Watching for\" rows"),
+    CUSTOM("Custom", "Nothing is changed for you: your theme and switches decide the look");
+
+    /** Colours for this profile's Home; [base] is returned untouched for Custom. */
+    fun colors(base: ColorScheme): ColorScheme = when (this) {
+        NETFLIX -> base.copy(
+            // Netflix's own app colours: #141414 background, #1F1F1F and #2F2F2F raised surfaces
+            background = Color(0xFF141414),
+            surface = Color(0xFF1F1F1F),
+            surfaceVariant = Color(0xFF2F2F2F),
+        )
+        CUSTOM -> base
+    }
+
+    /**
+     * The whole app's palette for this look (Settings, Search, Library, details, the tab bar), not just Home. Custom returns
+     * [base] untouched, so the Appearance theme keeps working as before. Netflix uses a white accent.
+     */
+    fun applyTo(base: ThemeColorPalette): ThemeColorPalette = when (this) {
+        NETFLIX -> ThemeColors.White.copy(
+            background = Color(0xFF141414),
+            backgroundElevated = Color(0xFF1F1F1F),
+            backgroundCard = Color(0xFF2F2F2F),
+        )
+        CUSTOM -> base
+    }
+
+    /**
+     * The one spot colour of this look: progress bars and the TOP 10 / New Episode / Airs Today tags: Netflix red (Custom keeps
+     * the same red the fork always used).
+     */
+    val brandColor: Color
+        get() = when (this) {
+            NETFLIX, CUSTOM -> Color(0xFFE50914)
+        }
+
+    /** The glow behind the wordmark on the start-up screen: Netflix red; null keeps the theme accent. */
+    val splashAccent: Color?
+        get() = when (this) {
+            NETFLIX -> Color(0xFFE50914)
+            CUSTOM -> null
+        }
+
+    companion object {
+        fun fromStored(value: String?): ForkStyle? =
+            if (value == "MAX" || value == "DISNEY") NETFLIX else entries.firstOrNull { it.name == value }
+    }
+}
+
+/** The Style of the profile that is active right now; updates when the profile or its style changes. */
+@Composable
+fun rememberForkActiveStyle(): ForkStyle {
+    androidx.compose.runtime.remember { ForkHomeSettings.ensureLoaded() }
+    val profileState by com.nuvio.app.features.profiles.ProfileRepository.state.collectAsStateWithLifecycle()
+    val styles by ForkHomeSettings.styleProfiles.collectAsStateWithLifecycle()
+    val index = profileState.activeProfile?.profileIndex ?: 1
+    return styles[index] ?: ForkStyle.NETFLIX
+}
+
+/** The active profile's [ForkStyle], read outside composition (the tags and progress bars that draw in the style's colour). */
+internal fun forkActiveStyleNow(): ForkStyle {
+    ForkHomeSettings.ensureLoaded()
+    return ForkHomeSettings.styleFor(com.nuvio.app.features.profiles.ProfileRepository.state.value.activeProfile?.profileIndex ?: 1)
+}
