+/** Fork: "Ends at 9:42 PM" if a movie of this length started now (Netflix Style). */
+internal object ForkEndsAt {
+    /** Minutes from a runtime like "96 min", "1h 36m" or "1:36". */
+    fun minutes(runtime: String?): Int? {
+        val text = runtime?.lowercase()?.takeIf { it.isNotBlank() } ?: return null
+        val numbers = Regex("\\d+").findAll(text).mapNotNull { it.value.toIntOrNull() }.toList()
+        val first = numbers.firstOrNull() ?: return null
+        val hasHours = text.contains("h") || text.contains(":")
+        val total = if (hasHours) first * 60 + (numbers.getOrNull(1) ?: 0) else first
+        return total.takeIf { it > 0 }
+    }
+
+    /** nil for series and unknown lengths. */
+    fun text(runtime: String?, isSeries: Boolean): String? {
+        if (isSeries) return null
+        val minutes = minutes(runtime) ?: return null
+        val end = (kotlin.time.Clock.System.now() + with(kotlin.time.Duration.Companion) { minutes.minutes })
+            .toLocalDateTime(kotlinx.datetime.TimeZone.currentSystemDefault())
+        val hour12 = when (val h = end.hour % 12) { 0 -> 12; else -> h }
+        val amPm = if (end.hour < 12) "AM" else "PM"
+        return "Ends at $hour12:${end.minute.toString().padStart(2, '0')} $amPm"
+    }
+}
