+
+/**
+ * Fork: one look per profile (Settings > Homescreen > Style).
+ *
+ * The look is chosen per profile and read on Home. Disney+ Style is the existing Disney look
+ * (navy, kids studio tiles); Netflix Style is a neutral near-black with the Netflix Home rows;
+ * Max Style is a deep violet. Custom changes nothing.
+ */
+enum class ForkStyle(val label: String, val summary: String) {
+    NETFLIX("Netflix Style", "Netflix's own #141414 Home with the billboard, Top 10, card tags and \"Continue Watching for\" rows"),
+    DISNEY("Disney+ Style", "Disney+'s deep navy Home with its blue accent and Disney, Pixar, DreamWorks, Illumination, Nickelodeon and Cartoon Network tiles"),
+    MAX("Max Style", "Max's black Home with Max Blue (#002BE7) as the accent"),
+    CUSTOM("Custom", "Nothing is changed for you: your theme and switches decide the look");
+
+    /** Colours for this profile's Home; [base] is returned untouched for Custom. */
+    fun colors(base: ColorScheme): ColorScheme = when (this) {
+        DISNEY -> base.copy(
+            // Disney+: deep navy #040714, #0E1735 and #1A2151 raised surfaces, brand blue #0089EC
+            background = Color(0xFF040714),
+            surface = Color(0xFF0E1735),
+            surfaceVariant = Color(0xFF1A2151),
+            primary = Color(0xFF0089EC),
+        )
+        NETFLIX -> base.copy(
+            // Netflix's own app colours: #141414 background, #1F1F1F and #2F2F2F raised surfaces
+            background = Color(0xFF141414),
+            surface = Color(0xFF1F1F1F),
+            surfaceVariant = Color(0xFF2F2F2F),
+        )
+        MAX -> base.copy(
+            // Max: pure black #000000 and Max Blue #002BE7 (both from the brand site); the raised greys are generic
+            background = Color(0xFF000000),
+            surface = Color(0xFF121212),
+            surfaceVariant = Color(0xFF1F1F1F),
+            primary = Color(0xFF002BE7),
+        )
+        CUSTOM -> base
+    }
+
+    /**
+     * The whole app's palette for this look (Settings, Search, Library, details, the tab bar), not just Home. Custom returns
+     * [base] untouched, so the Appearance theme keeps working as before. Netflix and Max use a white / Max Blue accent, Disney+ its blue.
+     */
+    fun applyTo(base: ThemeColorPalette): ThemeColorPalette = when (this) {
+        NETFLIX -> ThemeColors.White.copy(
+            background = Color(0xFF141414),
+            backgroundElevated = Color(0xFF1F1F1F),
+            backgroundCard = Color(0xFF2F2F2F),
+        )
+        DISNEY -> base.copy(
+            secondary = Color(0xFF0089EC),
+            secondaryVariant = Color(0xFF0068B4),
+            accentGradient = listOf(Color(0xFF0089EC)),
+            nativeAccentHex = "#0089EC",
+            onSecondary = Color.White,
+            onSecondaryVariant = Color.White,
+            focusRing = Color(0xFF8FD3FF),
+            focusBackground = Color(0xFF1A2151),
+            background = Color(0xFF040714),
+            backgroundElevated = Color(0xFF0E1735),
+            backgroundCard = Color(0xFF1A2151),
+        )
+        MAX -> base.copy(
+            secondary = Color(0xFF002BE7),
+            secondaryVariant = Color(0xFF0021B0),
+            accentGradient = listOf(Color(0xFF002BE7)),
+            nativeAccentHex = "#002BE7",
+            onSecondary = Color.White,
+            onSecondaryVariant = Color.White,
+            focusRing = Color.White,
+            focusBackground = Color(0xFF1F1F1F),
+            background = Color(0xFF000000),
+            backgroundElevated = Color(0xFF121212),
+            backgroundCard = Color(0xFF1F1F1F),
+        )
+        CUSTOM -> base
+    }
+
+    /**
+     * The one spot colour of this look: progress bars and the TOP 10 / New Episode / Airs Today tags. Netflix red, Disney+ blue
+     * or Max Blue; Custom keeps the red the fork always used.
+     */
+    val brandColor: Color
+        get() = when (this) {
+            NETFLIX, CUSTOM -> Color(0xFFE50914)
+            DISNEY -> Color(0xFF0089EC)
+            MAX -> Color(0xFF002BE7)
+        }
+
+    /** The glow behind the wordmark on the start-up screen: Netflix red, Disney+ blue, Max Blue; null keeps the theme accent. */
+    val splashAccent: Color?
+        get() = when (this) {
+            NETFLIX -> Color(0xFFE50914)
+            DISNEY -> Color(0xFF0089EC)
+            MAX -> Color(0xFF002BE7)
+            CUSTOM -> null
+        }
+
+    companion object {
+        fun fromStored(value: String?): ForkStyle? = entries.firstOrNull { it.name == value }
+    }
+}
+
+/** The Style of the profile that is active right now; updates when the profile or its style changes. */
+@Composable
+fun rememberForkActiveStyle(): ForkStyle {
+    androidx.compose.runtime.remember { ForkHomeSettings.ensureLoaded() }
+    val profileState by com.nuvio.app.features.profiles.ProfileRepository.state.collectAsStateWithLifecycle()
+    val styles by ForkHomeSettings.styleProfiles.collectAsStateWithLifecycle()
+    val disneyProfiles by ForkHomeSettings.disneyProfiles.collectAsStateWithLifecycle()
+    val index = profileState.activeProfile?.profileIndex ?: 1
+    return styles[index] ?: if (index in disneyProfiles) ForkStyle.DISNEY else ForkStyle.CUSTOM
+}
+
+/** The active profile's [ForkStyle], read outside composition (the tags and progress bars that draw in the style's colour). */
+internal fun forkActiveStyleNow(): ForkStyle {
+    ForkHomeSettings.ensureLoaded()
+    return ForkHomeSettings.styleFor(com.nuvio.app.features.profiles.ProfileRepository.state.value.activeProfile?.profileIndex ?: 1)
+}
