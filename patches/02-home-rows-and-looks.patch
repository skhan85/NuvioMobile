+import com.nuvio.app.features.watched.WatchedRepository
+import com.nuvio.app.features.watchprogress.ContinueWatchingItem
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+
+/**
+ * Fork: Play Something (Netflix) — a button at the top of Home that starts something without
+ * browsing: half the time a title you're in the middle of (resumed where you left off), otherwise
+ * an unwatched film from your Library or today's Top 10. Never the same title twice in a row.
+ */
+internal object ForkPlaySomething {
+    sealed interface Pick {
+        data class Resume(val item: ContinueWatchingItem) : Pick
+        data class Movie(val meta: MetaPreview) : Pick
+    }
+
+    private var lastPickedId: String? = null
+
+    fun pick(continueWatching: List<ContinueWatchingItem>, top10: List<MetaPreview>): Pick? {
+        val today = CurrentDateProvider.todayIsoDate()
+        val resumable = continueWatching.filter { it.parentMetaId != lastPickedId }
+        val inProgress = continueWatching.mapTo(mutableSetOf()) { it.parentMetaId }
+        val library = runCatching { LibraryRepository.uiState.value.items.map { it.toMetaPreview() } }
+            .getOrDefault(emptyList())
+        // Films only: they play straight away (a series would need its episode list first).
+        val fresh = (library + top10)
+            .filter { meta ->
+                meta.type.equals("movie", ignoreCase = true) &&
+                    meta.id.startsWith("tt") &&
+                    meta.id != lastPickedId &&
+                    meta.id !in inProgress &&
+                    !meta.isUnreleased(today) &&
+                    !runCatching { WatchedRepository.isWatched(id = meta.id, type = meta.type) }.getOrDefault(false)
+            }
+            .distinctBy { it.id }
+
+        val pick: Pick? = when {
+            resumable.isNotEmpty() && (fresh.isEmpty() || kotlin.random.Random.nextBoolean()) ->
+                Pick.Resume(resumable.random())
+            fresh.isNotEmpty() -> Pick.Movie(fresh.random())
+            else -> null
+        }
+        lastPickedId = when (pick) {
+            is Pick.Resume -> pick.item.parentMetaId
+            is Pick.Movie -> pick.meta.id
+            null -> lastPickedId
+        }
+        return pick
+    }
+}
+
+/** Starts a film from Home (set by the app shell for the Home tab). */
+internal val LocalForkPlayMovie = staticCompositionLocalOf<((MetaPreview) -> Unit)?> { null }
+
+@Composable
+internal fun ForkPlaySomethingButton(horizontalPadding: Dp, onClick: () -> Unit) {
+    Row(
+        modifier = Modifier
+            .padding(horizontal = horizontalPadding, vertical = 6.dp)
+            .clip(RoundedCornerShape(50))
+            .background(Color.White) // solid, so it stands out on any hero tint
+            .clickable(onClick = onClick)
+            .padding(horizontal = 16.dp, vertical = 9.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        Icon(
+            imageVector = Icons.Rounded.Shuffle,
+            contentDescription = null,
+            tint = Color.Black,
+            modifier = Modifier.size(18.dp),
+        )
+        Text(
+            text = "Play Something",
+            color = Color.Black,
+            fontSize = 14.sp,
+            fontWeight = FontWeight.SemiBold,
+        )
+    }
+}
