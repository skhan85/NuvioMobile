+package com.nuvio.app.features.home
+
+import android.content.Context
+import android.content.SharedPreferences
+
+internal actual object ForkHomeSettingsStorage {
+    private const val preferencesName = "nuvio_fork_home_settings"
+    private const val becauseKey = "fork_because_rows"
+    private const val trendingKey = "fork_trending_rows"
+    private const val whitePlayKey = "fork_white_play_button"
+    private const val kidsTrendingKey = "fork_kids_trending_profiles"
+    private const val kidsLimitKey = "fork_kids_limit_profiles"
+    private const val stillWatchingOffKey = "fork_still_watching_off_profiles"
+
+    private var preferences: SharedPreferences? = null
+
+    fun initialize(context: Context) {
+        preferences = context.getSharedPreferences(preferencesName, Context.MODE_PRIVATE)
+    }
+
+    actual fun loadBecauseRowsEnabled(): Boolean? =
+        preferences?.takeIf { it.contains(becauseKey) }?.getBoolean(becauseKey, true)
+
+    actual fun saveBecauseRowsEnabled(enabled: Boolean) {
+        preferences?.edit()?.putBoolean(becauseKey, enabled)?.apply()
+    }
+
+    actual fun loadTrendingRowsEnabled(): Boolean? =
+        preferences?.takeIf { it.contains(trendingKey) }?.getBoolean(trendingKey, true)
+
+    actual fun saveTrendingRowsEnabled(enabled: Boolean) {
+        preferences?.edit()?.putBoolean(trendingKey, enabled)?.apply()
+    }
+
+    actual fun loadWhitePlayButton(): Boolean? =
+        preferences?.takeIf { it.contains(whitePlayKey) }?.getBoolean(whitePlayKey, false)
+
+    actual fun saveWhitePlayButton(enabled: Boolean) {
+        preferences?.edit()?.putBoolean(whitePlayKey, enabled)?.apply()
+    }
+
+    actual fun loadKidsTrendingProfiles(): String? = preferences?.getString(kidsTrendingKey, null)
+
+    actual fun loadForkString(key: String): String? = preferences?.getString(key, null)
+
+    actual fun saveForkString(key: String, value: String) {
+        preferences?.edit()?.putString(key, value)?.apply()
+    }
+
+    actual fun loadStillWatchingOffProfiles(): String? = preferences?.getString(stillWatchingOffKey, null)
+
+    actual fun saveStillWatchingOffProfiles(value: String) {
+        preferences?.edit()?.putString(stillWatchingOffKey, value)?.apply()
+    }
+
+    actual fun loadKidsLimitProfiles(): String? = preferences?.getString(kidsLimitKey, null)
+
+    actual fun saveKidsLimitProfiles(value: String) {
+        preferences?.edit()?.putString(kidsLimitKey, value)?.apply()
+    }
+
+    actual fun saveKidsTrendingProfiles(value: String) {
+        preferences?.edit()?.putString(kidsTrendingKey, value)?.apply()
+    }
+}
