+                "Card tags (TOP 10, New Episode, Coming Soon) now show straight away: they're saved between launches and looked up for whole rows ahead.",
+                "Under the hood: the fork's changes are reorganised so Nuvio Enhanced updates break it less often.",
+            ),
+        ),
+    )
+
+    private const val SEEN_KEY = "fork_whats_new_seen"
+
+    fun unseen(): List<Entry> {
+        val seen = runCatching { ForkHomeSettingsStorage.loadForkString(SEEN_KEY)?.toIntOrNull() }.getOrNull() ?: 0
+        return entries.filter { it.id > seen }.sortedByDescending { it.id }.take(3)
+    }
+
+    fun markSeen() {
+        val latest = entries.maxOfOrNull { it.id } ?: return
+        runCatching { ForkHomeSettingsStorage.saveForkString(SEEN_KEY, latest.toString()) }
+    }
+}
+
+@Composable
+internal fun ForkWhatsNewDialog() {
+    var pending by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(ForkWhatsNew.unseen()) }
+    if (pending.isEmpty()) return
+    val dismiss = {
+        ForkWhatsNew.markSeen()
+        pending = emptyList()
+    }
+    androidx.compose.material3.AlertDialog(
+        onDismissRequest = dismiss,
+        title = { Text("What's new in your Nuvio") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                pending.forEach { entry ->
+                    Text(entry.date, style = MaterialTheme.typography.labelMedium, fontWeight = FontWeight.Bold)
+                    entry.items.forEach { item ->
+                        Text("•  $item", style = MaterialTheme.typography.bodyMedium)
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            androidx.compose.material3.TextButton(onClick = dismiss) { Text("Got it") }
+        },
+    )
+}
