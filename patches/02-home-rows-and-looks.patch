+import com.nuvio.app.features.watched.WatchedRepository
+import com.nuvio.app.features.watchprogress.ContinueWatchingItem
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+import com.nuvio.app.features.watchprogress.WatchProgressRepository
+import kotlin.coroutines.cancellation.CancellationException
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * Fork: "N left" on Continue Watching cards — how many aired episodes come after the one on the
+ * card and are not watched yet. Worked out in the background from the series' episode list (the
+ * same metadata the detail page uses); a card shows nothing until its count is known, and nothing
+ * when the count is 0 or the item is a movie.
+ *
+ * Counts are cached per card (series + the episode on it) for half an hour. Watching an episode
+ * moves the card to the next one, which is a new key, so the count follows without a refresh.
+ */
+internal object RemainingEpisodes {
+    private const val MAX_AGE_MS = 30 * 60 * 1_000L
+
+    private val counts = mutableMapOf<String, Pair<Int, TimeMark>>()
+    // One series at a time, so a long row does not fire a burst of metadata requests.
+    private val lock = Mutex()
+
+    fun key(item: ContinueWatchingItem): String? {
+        val s = item.seasonNumber ?: return null
+        val e = item.episodeNumber ?: return null
+        return "${item.parentMetaId}|$s:$e"
+    }
+
+    fun cached(item: ContinueWatchingItem): Int? = key(item)?.let { counts[it]?.first }
+
+    suspend fun count(item: ContinueWatchingItem): Int? {
+        val key = key(item) ?: return null
+        val season = item.seasonNumber ?: return null
+        val episode = item.episodeNumber ?: return null
+        counts[key]?.let { (n, at) -> if (at.elapsedNow().inWholeMilliseconds < MAX_AGE_MS) return n }
+        return lock.withLock {
+            counts[key]?.let { (n, at) -> if (at.elapsedNow().inWholeMilliseconds < MAX_AGE_MS) return@withLock n }
+            val type = item.parentMetaType
+            val meta = MetaDetailsRepository.peek(type, item.parentMetaId)?.takeIf { it.videos.isNotEmpty() }
+                ?: try {
+                    MetaDetailsRepository.fetch(type, item.parentMetaId, cacheResult = true)
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Throwable) {
+                    null
+                }
+            val videos = meta?.videos.orEmpty()
+            if (videos.isEmpty()) return@withLock null
+
+            val today = CurrentDateProvider.todayIsoDate().take(10)
+            val n = videos.count { video ->
+                val s = video.season ?: return@count false
+                val e = video.episode ?: return@count false
+                // Specials only count when the card itself is in the specials season.
+                if (s == 0 && season != 0) return@count false
+                if (s < season || (s == season && e <= episode)) return@count false
+                val released = video.released?.trim()?.takeIf { it.length >= 10 }?.take(10)
+                    ?: return@count false
+                if (released > today) return@count false
+                val watched = WatchedRepository.isWatched(id = item.parentMetaId, type = type, season = s, episode = e) ||
+                    WatchProgressRepository.progressForVideo(
+                        videoId = "${item.parentMetaId}:$s:$e",
+                        parentMetaId = item.parentMetaId,
+                        seasonNumber = s,
+                        episodeNumber = e,
+                    )?.isEffectivelyCompleted == true
+                !watched
+            }
+            counts[key] = n to TimeSource.Monotonic.markNow()
+            n
+        }
+    }
+}
+
+/** The "N left" pill for a card, or nothing. */
+@Composable
+internal fun RemainingEpisodesBadge(item: ContinueWatchingItem, modifier: Modifier = Modifier) {
+    val key = RemainingEpisodes.key(item) ?: return
+    var count by remember(key) { mutableStateOf(RemainingEpisodes.cached(item)) }
+    LaunchedEffect(key) { count = RemainingEpisodes.count(item) }
+    val n = count ?: return
+    if (n <= 0) return
+    Box(
+        modifier = modifier
+            .background(Color.Black.copy(alpha = 0.8f), RoundedCornerShape(12.dp))
+            .padding(horizontal = 8.dp, vertical = 4.dp),
+    ) {
+        Text(
+            text = "$n left",
+            style = MaterialTheme.typography.labelSmall.copy(fontSize = 11.sp, fontWeight = FontWeight.Bold),
+            color = Color.White,
+            maxLines = 1,
+        )
+    }
+}
+
+/** The shuffle badge and the "N left" pill, side by side, for a card's top-left corner. */
+@Composable
+internal fun ContinueWatchingTopStartBadges(item: ContinueWatchingItem, modifier: Modifier = Modifier) {
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (item.shufflePlayback) ShuffleBadge()
+        RemainingEpisodesBadge(item)
+    }
+}
