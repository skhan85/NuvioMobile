+                            description = "Hide titles rated above PG / TV-PG everywhere for " +
+                                (forkLimitName?.let { "the $it profile" } ?: "this profile"),
+                            checked = forkLimitIndex in kidsLimitProfiles,
+                            isTablet = isTablet,
+                            onCheckedChange = { ForkHomeSettings.setKidsLimit(forkLimitIndex, it) },
+                        )
+                    }
+                    // Fork: Netflix Home and card tags.
+                    run {
+                        val forkNetflixHome by remember {
+                            ForkHomeSettings.ensureLoaded()
+                            ForkHomeSettings.netflixHome
+                        }.collectAsStateWithLifecycle()
+                        val forkCardBadges by ForkHomeSettings.cardBadges.collectAsStateWithLifecycle()
+                        SettingsGroupDivider(isTablet = isTablet)
+                        SettingsSwitchRow(
+                            title = "Netflix Home",
+                            description = "Genre line on the hero, and \"Continue Watching for\" your name with Netflix-style cards",
+                            checked = forkNetflixHome,
+                            isTablet = isTablet,
+                            onCheckedChange = ForkHomeSettings::setNetflixHome,
+                        )
+                        // Fork: Style, per profile: Netflix Style (the default) or Custom.
+                        val forkStyleProfileState by com.nuvio.app.features.profiles.ProfileRepository.state
+                            .collectAsStateWithLifecycle()
+                        val forkStyleIndex = forkStyleProfileState.activeProfile?.profileIndex ?: 1
+                        val forkStyleProfiles by ForkHomeSettings.styleProfiles.collectAsStateWithLifecycle()
+                        val forkCurrentStyle = forkStyleProfiles[forkStyleIndex] ?: ForkStyle.NETFLIX
+                        SettingsGroupDivider(isTablet = isTablet)
+                        SettingsChipRow(
+                            title = "Style",
+                            description = "The look of Home for this profile",
+                            isTablet = isTablet,
+                            footer = forkCurrentStyle.summary,
+                        ) {
+                            ForkStyle.entries.forEach { style ->
+                                Chip(
+                                    label = style.label,
+                                    selected = forkCurrentStyle == style,
+                                    onClick = { ForkHomeSettings.setStyle(forkStyleIndex, style) },
+                                )
+                            }
+                        }
+                        SettingsGroupDivider(isTablet = isTablet)
+                        SettingsSwitchRow(
+                            title = "Card Tags",
+                            description = "Netflix TOP 10 tags, New Episode / New Season / Recently Added tags, and the original language (KOREAN, HINDI…) on non-English titles, from TMDB",
+                            checked = forkCardBadges,
+                            isTablet = isTablet,
+                            onCheckedChange = ForkHomeSettings::setCardBadges,
+                        )
+                        val forkPlaySomething by ForkHomeSettings.playSomething.collectAsStateWithLifecycle()
+                        SettingsGroupDivider(isTablet = isTablet)
+                        SettingsSwitchRow(
+                            title = "Play Something",
+                            description = "A shuffle button at the top of Home: resumes something you're watching or plays an unwatched film from your Library or today's Top 10",
+                            checked = forkPlaySomething,
+                            isTablet = isTablet,
+                            onCheckedChange = ForkHomeSettings::setPlaySomething,
+                        )
+                    }
+                }
+                androidx.compose.foundation.layout.Spacer(
+                    Modifier.padding(top = if (isTablet) 16.dp else 12.dp),
+                )
+
                 HomescreenCatalogList(
                     isTablet = isTablet,
                     items = items,
