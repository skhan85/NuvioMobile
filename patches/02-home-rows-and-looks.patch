+package com.nuvio.app.features.home
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.profiles.ProfileRepository
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+
+/**
+ * Fork: kids rating limit (Disney+-style). On a profile with it on, titles rated above
+ * PG / TV-PG are hidden from Home rows, collections, search and More Like This. Ratings come
+ * from TMDB (US first) and are kept for the session; titles with no known rating stay hidden.
+ */
+object ForkKidsFilter {
+    private val allowedRatings = setOf(
+        "G", "PG", "TV-Y", "TV-Y7", "TV-Y7-FV", "TV-G", "TV-PG",
+        "U", "UC", "0", "6", "L", "AL", "ALL", "TP", "LIVRE",
+    )
+
+    private val _verdicts = MutableStateFlow<Map<String, Boolean>>(emptyMap())
+    /** Item key → may a kids profile see it. Grows as ratings arrive. */
+    val verdicts: StateFlow<Map<String, Boolean>> = _verdicts.asStateFlow()
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val limiter = Semaphore(6)
+    private val inFlightMutex = Mutex()
+    private val inFlight = mutableSetOf<String>()
+
+    fun isAllowedRating(rating: String?): Boolean {
+        val normalized = rating?.trim()?.uppercase().orEmpty()
+        return normalized.isNotEmpty() && normalized in allowedRatings
+    }
+
+    private fun key(item: MetaPreview) = item.stableKey()
+
+    /** Items a kids profile may see now; unknown ratings are looked up and fill in later. */
+    fun visible(items: List<MetaPreview>, known: Map<String, Boolean>): List<MetaPreview> {
+        val unknown = items.filter { known[key(it)] == null }
+        if (unknown.isNotEmpty()) request(unknown)
+        return items.filter { known[key(it)] == true }
+    }
+
+    private fun request(items: List<MetaPreview>) {
+        scope.launch {
+            val fresh = inFlightMutex.withLock {
+                items.filter { inFlight.add(key(it)) }
+            }
+            fresh.forEach { item ->
+                launch {
+                    val ok = limiter.withPermit {
+                        isAllowedRating(runCatching { TmdbMetadataService.forkAgeRating(item.id, item.type) }.getOrNull())
+                    }
+                    _verdicts.update { it + (key(item) to ok) }
+                    inFlightMutex.withLock { inFlight.remove(key(item)) }
+                }
+            }
+        }
+    }
+
+    /** Waits for every rating first (search: a short list worth a brief wait). */
+    suspend fun resolvedVisible(items: List<MetaPreview>): List<MetaPreview> {
+        val known = _verdicts.value
+        coroutineScope {
+            items.filter { known[key(it)] == null }.take(60).map { item ->
+                async {
+                    val ok = limiter.withPermit {
+                        isAllowedRating(runCatching { TmdbMetadataService.forkAgeRating(item.id, item.type) }.getOrNull())
+                    }
+                    _verdicts.update { it + (key(item) to ok) }
+                }
+            }.awaitAll()
+        }
+        val now = _verdicts.value
+        return items.filter { now[key(it)] == true }
+    }
+}
+
+/** Fork: the active profile's kids filter — returns the list unchanged when the limit is off. */
+@Composable
+fun rememberForkKidsFilter(): (List<MetaPreview>) -> List<MetaPreview> {
+    val profileState by ProfileRepository.state.collectAsStateWithLifecycle()
+    val profileIndex = profileState.activeProfile?.profileIndex ?: 1
+    val limitProfiles by remember {
+        ForkHomeSettings.ensureLoaded()
+        ForkHomeSettings.kidsLimitProfiles
+    }.collectAsStateWithLifecycle()
+    val known by ForkKidsFilter.verdicts.collectAsStateWithLifecycle()
+    val active = profileIndex in limitProfiles
+    return remember(active, known) {
+        if (!active) { items -> items } else { items -> ForkKidsFilter.visible(items, known) }
+    }
+}
+
+/** Fork: the same filter over catalog sections (empty sections are dropped). */
+fun List<HomeCatalogSection>.forkKids(filter: (List<MetaPreview>) -> List<MetaPreview>): List<HomeCatalogSection> =
+    mapNotNull { section ->
+        val items = filter(section.items)
+        if (items === section.items) section
+        else if (items.isEmpty()) null
+        else section.copy(items = items, availableItemCount = items.size)
+    }
