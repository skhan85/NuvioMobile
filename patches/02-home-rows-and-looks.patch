+package com.nuvio.app.features.home
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+internal expect object ForkHomeSettingsStorage {
+    fun loadBecauseRowsEnabled(): Boolean?
+    fun saveBecauseRowsEnabled(enabled: Boolean)
+    fun loadTrendingRowsEnabled(): Boolean?
+    fun saveTrendingRowsEnabled(enabled: Boolean)
+    fun loadWhitePlayButton(): Boolean?
+    fun saveWhitePlayButton(enabled: Boolean)
+    fun loadKidsTrendingProfiles(): String?
+    fun saveKidsTrendingProfiles(value: String)
+    fun loadKidsLimitProfiles(): String?
+    fun saveKidsLimitProfiles(value: String)
+    fun loadStillWatchingOffProfiles(): String?
+    fun loadForkString(key: String): String?
+    fun saveForkString(key: String, value: String)
+    fun saveStillWatchingOffProfiles(value: String)
+}
+
+/** Fork: on/off switches for the fork's own Home rows. Device-local, not synced. */
+object ForkHomeSettings {
+    private val _becauseRowsEnabled = MutableStateFlow(true)
+    val becauseRowsEnabled: StateFlow<Boolean> = _becauseRowsEnabled.asStateFlow()
+    private val _trendingRowsEnabled = MutableStateFlow(true)
+    val trendingRowsEnabled: StateFlow<Boolean> = _trendingRowsEnabled.asStateFlow()
+    private val _whitePlayButton = MutableStateFlow(false)
+    /** Fork: Netflix-style white Play button on the details page instead of the theme accent. */
+    val whitePlayButton: StateFlow<Boolean> = _whitePlayButton.asStateFlow()
+    private val _kidsTrendingProfiles = MutableStateFlow<Set<Int>>(emptySet())
+    /** Fork: profiles (by profile index) whose Top 10 / Trending rows only show kid-friendly titles. */
+    val kidsTrendingProfiles: StateFlow<Set<Int>> = _kidsTrendingProfiles.asStateFlow()
+    private val _kidsLimitProfiles = MutableStateFlow<Set<Int>>(emptySet())
+    /** Fork: profiles (by profile index) that only see titles rated up to PG / TV-PG. */
+    val kidsLimitProfiles: StateFlow<Set<Int>> = _kidsLimitProfiles.asStateFlow()
+    private val _stillWatchingOffProfiles = MutableStateFlow<Set<Int>>(emptySet())
+    /** Fork: profiles that turned "Are you still watching?" off (it's on by default). */
+    val stillWatchingOffProfiles: StateFlow<Set<Int>> = _stillWatchingOffProfiles.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _becauseRowsEnabled.value = ForkHomeSettingsStorage.loadBecauseRowsEnabled() ?: true
+        _trendingRowsEnabled.value = ForkHomeSettingsStorage.loadTrendingRowsEnabled() ?: true
+        _whitePlayButton.value = ForkHomeSettingsStorage.loadWhitePlayButton() ?: false
+        _disneyProfiles.value = ForkHomeSettingsStorage.loadForkString("fork_disney_profiles")
+            ?.split(',')
+            ?.mapNotNull { it.trim().toIntOrNull() }
+            ?.toSet()
+            ?: emptySet()
+        _styleProfiles.value = ForkHomeSettingsStorage.loadForkString("fork_style_profiles")
+            ?.split(',')
+            ?.mapNotNull { part ->
+                val pieces = part.split(':')
+                val index = pieces.getOrNull(0)?.trim()?.toIntOrNull()
+                val style = ForkStyle.fromStored(pieces.getOrNull(1)?.trim())
+                if (index != null && style != null) index to style else null
+            }
+            ?.toMap()
+            ?: emptyMap()
+        _netflixHome.value = ForkHomeSettingsStorage.loadForkString("fork_netflix_home")?.toBooleanStrictOrNull() ?: true
+        _cardBadges.value = ForkHomeSettingsStorage.loadForkString("fork_card_badges")?.toBooleanStrictOrNull() ?: true
+        _comingSoon.value = ForkHomeSettingsStorage.loadForkString("fork_coming_soon")?.toBooleanStrictOrNull() ?: true
+        _playSomething.value = ForkHomeSettingsStorage.loadForkString("fork_play_something")?.toBooleanStrictOrNull() ?: true
+        _stillWatchingOffProfiles.value = ForkHomeSettingsStorage.loadStillWatchingOffProfiles()
+            ?.split(',')
+            ?.mapNotNull { it.trim().toIntOrNull() }
+            ?.toSet()
+            ?: emptySet()
+        _kidsLimitProfiles.value = ForkHomeSettingsStorage.loadKidsLimitProfiles()
+            ?.split(',')
+            ?.mapNotNull { it.trim().toIntOrNull() }
+            ?.toSet()
+            ?: emptySet()
+        _kidsTrendingProfiles.value = ForkHomeSettingsStorage.loadKidsTrendingProfiles()
+            ?.split(',')
+            ?.mapNotNull { it.trim().toIntOrNull() }
+            ?.toSet()
+            ?: emptySet()
+    }
+
+    private val _netflixHome = MutableStateFlow(true)
+    /** Fork: Netflix Home — Shows / Movies switch, genre line, "Continue Watching for <name>". */
+    val netflixHome: StateFlow<Boolean> = _netflixHome.asStateFlow()
+    private val _comingSoon = MutableStateFlow(true)
+    /** Fork: the Coming Soon row on Home (with Trending rows on). */
+    val comingSoon: StateFlow<Boolean> = _comingSoon.asStateFlow()
+
+    fun setComingSoon(enabled: Boolean) {
+        ensureLoaded()
+        _comingSoon.value = enabled
+        ForkHomeSettingsStorage.saveForkString("fork_coming_soon", enabled.toString())
+    }
+
+    private val _playSomething = MutableStateFlow(true)
+    /** Fork: the Play Something (shuffle) button at the top of Home. */
+    val playSomething: StateFlow<Boolean> = _playSomething.asStateFlow()
+
+    fun setPlaySomething(enabled: Boolean) {
+        ensureLoaded()
+        _playSomething.value = enabled
+        ForkHomeSettingsStorage.saveForkString("fork_play_something", enabled.toString())
+    }
+
+    private val _cardBadges = MutableStateFlow(true)
+    /** Fork: TOP 10 and New Episode / New Season / Recently Added tags on posters. */
+    val cardBadges: StateFlow<Boolean> = _cardBadges.asStateFlow()
+
+    private val _disneyProfiles = MutableStateFlow<Set<Int>>(emptySet())
+    /** Fork: profiles (by profile index) with the Disney+ look (navy theme, kids studio tiles). */
+    val disneyProfiles: StateFlow<Set<Int>> = _disneyProfiles.asStateFlow()
+
+    private val _styleProfiles = MutableStateFlow<Map<Int, ForkStyle>>(emptyMap())
+    /** Fork: the style chosen per profile (by profile index). A profile with none chosen keeps its old Disney switch. */
+    val styleProfiles: StateFlow<Map<Int, ForkStyle>> = _styleProfiles.asStateFlow()
+
+    /** The style for a profile: the one chosen, else Disney+ if that profile had the old Disney switch on, else Custom. */
+    fun styleFor(profileIndex: Int): ForkStyle =
+        _styleProfiles.value[profileIndex]
+            ?: if (profileIndex in _disneyProfiles.value) ForkStyle.DISNEY else ForkStyle.CUSTOM
+
+    /** The style of whichever profile was last on Home: the start-up screen uses it, before any profile is chosen. */
+    fun lastStyle(): ForkStyle =
+        ForkStyle.fromStored(ForkHomeSettingsStorage.loadForkString("fork_last_style")) ?: ForkStyle.CUSTOM
+
+    fun rememberLastStyle(style: ForkStyle) {
+        ForkHomeSettingsStorage.saveForkString("fork_last_style", style.name)
+    }
+
+    fun setStyle(profileIndex: Int, style: ForkStyle) {
+        ensureLoaded()
+        val updated = _styleProfiles.value + (profileIndex to style)
+        _styleProfiles.value = updated
+        ForkHomeSettingsStorage.saveForkString(
+            "fork_style_profiles",
+            updated.entries.sortedBy { it.key }.joinToString(",") { "${it.key}:${it.value.name}" },
+        )
+        setDisneyStyle(profileIndex, style == ForkStyle.DISNEY) // the studio tiles still follow this switch
+        if (style == ForkStyle.NETFLIX) {
+            // The Netflix rows are what makes Netflix Style: make sure they are on.
+            setNetflixHome(true)
+            setCardBadges(true)
+            setTrendingRowsEnabled(true)
+        }
+    }
+
+    fun setDisneyStyle(profileIndex: Int, enabled: Boolean) {
+        ensureLoaded()
+        val updated = if (enabled) _disneyProfiles.value + profileIndex else _disneyProfiles.value - profileIndex
+        _disneyProfiles.value = updated
+        ForkHomeSettingsStorage.saveForkString("fork_disney_profiles", updated.sorted().joinToString(","))
+    }
+
+    fun setNetflixHome(enabled: Boolean) {
+        ensureLoaded()
+        _netflixHome.value = enabled
+        ForkHomeSettingsStorage.saveForkString("fork_netflix_home", enabled.toString())
+    }
+
+    fun setCardBadges(enabled: Boolean) {
+        ensureLoaded()
+        _cardBadges.value = enabled
+        ForkHomeSettingsStorage.saveForkString("fork_card_badges", enabled.toString())
+    }
+
+    fun setStillWatching(profileIndex: Int, enabled: Boolean) {
+        ensureLoaded()
+        val updated = if (enabled) _stillWatchingOffProfiles.value - profileIndex
+        else _stillWatchingOffProfiles.value + profileIndex
+        _stillWatchingOffProfiles.value = updated
+        ForkHomeSettingsStorage.saveStillWatchingOffProfiles(updated.sorted().joinToString(","))
+    }
+
+    fun setKidsLimit(profileIndex: Int, enabled: Boolean) {
+        ensureLoaded()
+        val updated = if (enabled) _kidsLimitProfiles.value + profileIndex
+        else _kidsLimitProfiles.value - profileIndex
+        _kidsLimitProfiles.value = updated
+        ForkHomeSettingsStorage.saveKidsLimitProfiles(updated.sorted().joinToString(","))
+    }
+
+    fun setKidsTrending(profileIndex: Int, enabled: Boolean) {
+        ensureLoaded()
+        val updated = if (enabled) _kidsTrendingProfiles.value + profileIndex
+        else _kidsTrendingProfiles.value - profileIndex
+        _kidsTrendingProfiles.value = updated
+        ForkHomeSettingsStorage.saveKidsTrendingProfiles(updated.sorted().joinToString(","))
+    }
+
+    fun setWhitePlayButton(enabled: Boolean) {
+        ensureLoaded()
+        _whitePlayButton.value = enabled
+        ForkHomeSettingsStorage.saveWhitePlayButton(enabled)
+    }
+
+    fun setTrendingRowsEnabled(enabled: Boolean) {
+        ensureLoaded()
+        _trendingRowsEnabled.value = enabled
+        ForkHomeSettingsStorage.saveTrendingRowsEnabled(enabled)
+    }
+
+    fun setBecauseRowsEnabled(enabled: Boolean) {
+        ensureLoaded()
+        _becauseRowsEnabled.value = enabled
+        ForkHomeSettingsStorage.saveBecauseRowsEnabled(enabled)
+    }
+}
