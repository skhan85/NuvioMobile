+    Row(modifier = modifier, horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+        tags.languages.take(2).forEach { language -> ForkStreamLanguageChip(language, highlighted = true) }
+        if (tags.multiAudio) ForkStreamLanguageChip("Multi-audio", highlighted = false)
+    }
+}
