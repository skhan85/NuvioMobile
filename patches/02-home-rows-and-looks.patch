@@ -0,0 +1,190 @@
+package com.nuvio.app.features.home
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.nuvio.app.features.streams.StreamItem
+
+/**
+ * Fork: audio languages a source says it has, read from its name, text and file name ("Hindi",
+ * "Dual Audio", "🇮🇳 Hindi | English", "MULTi"), shown as small tags on the source card. When the
+ * profile's audio language isn't English, sources in that language are listed first, so Infuse
+ * (which can't be told which audio track to pick) gets the right file. Also the language tag
+ * (KOREAN, HINDI…) on non-English titles' cards (from TMDB's original language).
+ */
+internal object ForkLanguages {
+    data class Tags(val languages: List<String> = emptyList(), val multiAudio: Boolean = false) {
+        val isEmpty get() = languages.isEmpty() && !multiAudio
+    }
+
+    val TagColor = Color(0xFFFFB545)
+
+    /** Name, ISO code and the words or flags that mean it. Order is the order tags are shown in. */
+    private val table: List<Triple<String, String, Regex>> = listOf(
+        Triple("Hindi", "hi", """\bhindi\b|\bhin\b|🇮🇳"""),
+        Triple("Tamil", "ta", """\btamil\b"""),
+        Triple("Telugu", "te", """\btelugu\b"""),
+        Triple("Malayalam", "ml", """\bmalayalam\b"""),
+        Triple("Kannada", "kn", """\bkannada\b"""),
+        Triple("Punjabi", "pa", """\bpunjabi\b"""),
+        Triple("Bengali", "bn", """\bbengali\b"""),
+        Triple("Marathi", "mr", """\bmarathi\b"""),
+        Triple("Urdu", "ur", """\burdu\b"""),
+        Triple("Spanish", "es", """\bspanish\b|\blatino\b|\bcastellano\b|🇪🇸|🇲🇽"""),
+        Triple("French", "fr", """\bfrench\b|\btruefrench\b|\bvff\b|🇫🇷"""),
+        Triple("German", "de", """\bgerman\b|🇩🇪"""),
+        Triple("Italian", "it", """\bitalian\b|🇮🇹"""),
+        Triple("Portuguese", "pt", """\bportuguese\b|🇵🇹|🇧🇷"""),
+        Triple("Russian", "ru", """\brussian\b|🇷🇺"""),
+        Triple("Arabic", "ar", """\barabic\b|🇸🇦"""),
+        Triple("Turkish", "tr", """\bturkish\b|🇹🇷"""),
+        Triple("Japanese", "ja", """\bjapanese\b|🇯🇵"""),
+        Triple("Korean", "ko", """\bkorean\b|🇰🇷"""),
+        Triple("Chinese", "zh", """\bchinese\b|\bmandarin\b|\bcantonese\b|🇨🇳"""),
+    ).map { (name, code, pattern) -> Triple(name, code, Regex(pattern, RegexOption.IGNORE_CASE)) }
+
+    private val english = Regex("""\benglish\b|\beng\b|🇬🇧|🇺🇸""", RegexOption.IGNORE_CASE)
+
+    /** "Multi Audio", "Dual-Audio", "multi lang", or a bare "MULTi" (not "multi sub"). */
+    private val multi = Regex(
+        """\b(multi|dual)[ ._-]?(audio|lang|language)s?\b|\bmulti\b(?![ ._-]?subs?\b)""",
+        RegexOption.IGNORE_CASE,
+    )
+
+    fun tags(stream: StreamItem): Tags = tags(
+        listOfNotNull(stream.name, stream.title, stream.description, stream.behaviorHints.filename)
+            .joinToString("\n"),
+    )
+
+    fun tags(raw: String): Tags {
+        if (raw.isBlank()) return Tags()
+        val text = withAioLanguages(raw)
+        val languages = table.filter { it.third.containsMatchIn(text) }.map { it.first }
+        val hasEnglish = english.containsMatchIn(text)
+        val multiAudio = multi.containsMatchIn(text) || languages.size + (if (hasEnglish) 1 else 0) >= 2
+        return Tags(languages, multiAudio)
+    }
+
+    /**
+     * AIOStreams rewrites each source's text and lists its audio languages as small-caps ISO codes after a
+     * marker ("📣 ᴇɴ • ʜɪ • ᴋᴏ"), which the words and flags above never match. The codes on such a line are
+     * turned back into names ("English Hindi Korean") and added to the text, so tags and the
+     * preferred-language order see them too.
+     */
+    private val smallCaps = mapOf(
+        'ᴀ' to 'a', 'ʙ' to 'b', 'ᴄ' to 'c', 'ᴅ' to 'd', 'ᴇ' to 'e', 'ꜰ' to 'f', 'ɢ' to 'g', 'ʜ' to 'h', 'ɪ' to 'i',
+        'ᴊ' to 'j', 'ᴋ' to 'k', 'ʟ' to 'l', 'ᴍ' to 'm', 'ɴ' to 'n', 'ᴏ' to 'o', 'ᴘ' to 'p', 'ǫ' to 'q', 'ʀ' to 'r',
+        'ꜱ' to 's', 'ᴛ' to 't', 'ᴜ' to 'u', 'ᴠ' to 'v', 'ᴡ' to 'w', 'ʏ' to 'y', 'ᴢ' to 'z',
+    )
+    private val languageMarkers = listOf("📣", "🗣")
+
+    internal fun withAioLanguages(text: String): String {
+        val found = text.lineSequence()
+            .mapNotNull { line -> languageMarkers.map { line.indexOf(it) }.filter { it >= 0 }.minOrNull()?.let { line.substring(it) } }
+            .flatMap { line ->
+                line.map { smallCaps[it] ?: it }.joinToString("").lowercase()
+                    .split(Regex("[^a-z-]+")).asSequence()
+            }
+            .map { it.substringBefore('-') }
+            .filter { it.length in 2..3 }
+            .mapNotNull { code -> if (code == "en" || code == "eng") "English" else table.firstOrNull { it.second == code }?.first }
+            .distinct()
+            .toList()
+        return if (found.isEmpty()) text else text + "\n" + found.joinToString(" ")
+    }
+
+    /** "Korean" for TMDB's "ko"; null for English, "xx" (no language) and codes not listed. */
+    fun originalLabel(code: String?): String? = code?.lowercase()?.let { names[it] }
+
+    private val names = mapOf(
+        "ar" to "Arabic", "bg" to "Bulgarian", "bn" to "Bengali", "ca" to "Catalan", "cn" to "Cantonese",
+        "cs" to "Czech", "da" to "Danish", "de" to "German", "el" to "Greek", "es" to "Spanish",
+        "et" to "Estonian", "fa" to "Persian", "fi" to "Finnish", "fil" to "Filipino", "fr" to "French",
+        "gu" to "Gujarati", "he" to "Hebrew", "hi" to "Hindi", "hr" to "Croatian", "hu" to "Hungarian",
+        "id" to "Indonesian", "is" to "Icelandic", "it" to "Italian", "ja" to "Japanese", "ka" to "Georgian",
+        "kn" to "Kannada", "ko" to "Korean", "lt" to "Lithuanian", "lv" to "Latvian", "ml" to "Malayalam",
+        "mr" to "Marathi", "ms" to "Malay", "nb" to "Norwegian", "nl" to "Dutch", "no" to "Norwegian",
+        "pa" to "Punjabi", "pl" to "Polish", "pt" to "Portuguese", "ro" to "Romanian", "ru" to "Russian",
+        "sk" to "Slovak", "sl" to "Slovenian", "sr" to "Serbian", "sv" to "Swedish", "sw" to "Swahili",
+        "ta" to "Tamil", "te" to "Telugu", "th" to "Thai", "tl" to "Tagalog", "tr" to "Turkish",
+        "uk" to "Ukrainian", "ur" to "Urdu", "vi" to "Vietnamese", "zh" to "Chinese",
+    )
+
+    /**
+     * The original language for the details page ("Korean"), from TMDB's code ("ko") or an add-on's
+     * name ("Korean, English"); null for English, unknown codes or nothing.
+     */
+    fun displayName(value: String?): String? {
+        val first = value?.split(',', '/', '|')?.firstOrNull()?.trim()?.takeIf { it.isNotEmpty() } ?: return null
+        val lower = first.lowercase()
+        if (lower == "en" || lower == "eng" || lower == "english") return null
+        names[lower]?.let { return it }
+        if (lower.length <= 3 || first.any { !it.isLetter() && it != ' ' }) return null
+        return first.replaceFirstChar { it.uppercaseChar() }
+    }
+
+    /** The language to list first for a profile audio setting ("hi"), or null (English, device, original…). */
+    fun boostLanguage(audioCode: String?): String? {
+        val code = audioCode?.lowercase()?.substringBefore('-')?.takeIf { it.isNotBlank() && it != "en" } ?: return null
+        return table.firstOrNull { it.second == code }?.first
+    }
+
+    /** Sources that list `language` first, keeping everything else in its order. */
+    fun boosted(streams: List<StreamItem>, language: String?): List<StreamItem> {
+        if (language == null || streams.size < 2) return streams
+        val (first, rest) = streams.partition { language in tags(it).languages }
+        return if (first.isEmpty()) streams else first + rest
+    }
+}
