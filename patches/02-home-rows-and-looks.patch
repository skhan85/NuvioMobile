+/**
+ * Fork: a backdrop for each catalogue tile under Netflix Style — the wide picture of
+ * the first title in the folder's first source (the folder's own hero backdrop wins if it has one).
+ * Tiles in the same row don't repeat a picture. Kept for the app session.
+ */
+internal object ForkFolderBackdrops {
+    private val state = MutableStateFlow<Map<String, String>>(emptyMap())
+    val backdrops: StateFlow<Map<String, String>> = state.asStateFlow()
+    private val requested = mutableSetOf<String>()
+    private val lock = Mutex()
+    private val gate = Semaphore(3)
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    fun load(folder: com.nuvio.app.features.collection.CollectionFolder) {
+        scope.launch {
+            val fresh = lock.withLock { requested.add(folder.id) }
+            if (!fresh) return@launch
+            folder.heroBackdropUrl?.takeIf { it.isNotBlank() }?.let { url ->
+                state.update { it + (folder.id to url) }
+                return@launch
+            }
+            val items = gate.withPermit {
+                runCatching { firstPage(folder) }.getOrNull().orEmpty()
+            }
+            val pictures = items.mapNotNull { item ->
+                item.banner?.takeIf { it.isNotBlank() }
+                    // Smaller TMDB size: tiles are about 230 points wide.
+                    ?.replace("/t/p/w1280/", "/t/p/w780/")
+                    ?.replace("/t/p/original/", "/t/p/w780/")
+            }
+            if (pictures.isEmpty()) return@launch
+            lock.withLock {
+                val used = state.value.values.toSet()
+                val pick = pictures.firstOrNull { it !in used } ?: pictures.first()
+                state.update { it + (folder.id to pick) }
+            }
+        }
+    }
+
+    private suspend fun firstPage(folder: com.nuvio.app.features.collection.CollectionFolder): List<MetaPreview> {
+        val source = folder.resolvedSources.firstOrNull() ?: return emptyList()
+        return when {
+            source.isTmdb -> com.nuvio.app.features.collection.TmdbCollectionSourceResolver.resolve(source).items
+            source.isTrakt -> com.nuvio.app.features.trakt.TraktPublicListSourceResolver.resolve(source).items
+            else -> {
+                val catalogSource = source.addonCatalogSource() ?: return emptyList()
+                val resolved = com.nuvio.app.features.addons.AddonRepository.uiState.value.addons
+                    .findCollectionCatalog(catalogSource) ?: return emptyList()
+                com.nuvio.app.features.catalog.fetchCatalogPage(
+                    manifestUrl = resolved.addon.manifestUrl,
+                    type = catalogSource.type,
+                    catalogId = catalogSource.catalogId,
+                    genre = catalogSource.genre,
+                    maxItems = 12,
+                ).items
+            }
+        }
+    }
+}
