+package com.nuvio.app.features.home
+
+import platform.Foundation.NSUserDefaults
+
+internal actual object ForkHomeSettingsStorage {
+    private const val becauseKey = "fork_because_rows"
+    private const val trendingKey = "fork_trending_rows"
+    private const val whitePlayKey = "fork_white_play_button"
+    private const val kidsTrendingKey = "fork_kids_trending_profiles"
+    private const val kidsLimitKey = "fork_kids_limit_profiles"
+    private const val stillWatchingOffKey = "fork_still_watching_off_profiles"
+
+    actual fun loadBecauseRowsEnabled(): Boolean? {
+        val defaults = NSUserDefaults.standardUserDefaults
+        return if (defaults.objectForKey(becauseKey) == null) null else defaults.boolForKey(becauseKey)
+    }
+
+    actual fun saveBecauseRowsEnabled(enabled: Boolean) {
+        NSUserDefaults.standardUserDefaults.setBool(enabled, forKey = becauseKey)
+    }
+
+    actual fun loadTrendingRowsEnabled(): Boolean? {
+        val defaults = NSUserDefaults.standardUserDefaults
+        return if (defaults.objectForKey(trendingKey) == null) null else defaults.boolForKey(trendingKey)
+    }
+
+    actual fun saveTrendingRowsEnabled(enabled: Boolean) {
+        NSUserDefaults.standardUserDefaults.setBool(enabled, forKey = trendingKey)
+    }
+
+    actual fun loadWhitePlayButton(): Boolean? {
+        val defaults = NSUserDefaults.standardUserDefaults
+        return if (defaults.objectForKey(whitePlayKey) == null) null else defaults.boolForKey(whitePlayKey)
+    }
+
+    actual fun saveWhitePlayButton(enabled: Boolean) {
+        NSUserDefaults.standardUserDefaults.setBool(enabled, forKey = whitePlayKey)
+    }
+
+    actual fun loadForkString(key: String): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(key)
+
+    actual fun saveForkString(key: String, value: String) {
+        NSUserDefaults.standardUserDefaults.setObject(value, forKey = key)
+    }
+
+    actual fun loadStillWatchingOffProfiles(): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(stillWatchingOffKey)
+
+    actual fun saveStillWatchingOffProfiles(value: String) {
+        NSUserDefaults.standardUserDefaults.setObject(value, forKey = stillWatchingOffKey)
+    }
+
+    actual fun loadKidsLimitProfiles(): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(kidsLimitKey)
+
+    actual fun saveKidsLimitProfiles(value: String) {
+        NSUserDefaults.standardUserDefaults.setObject(value, forKey = kidsLimitKey)
+    }
+
+    actual fun loadKidsTrendingProfiles(): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(kidsTrendingKey)
+
+    actual fun saveKidsTrendingProfiles(value: String) {
+        NSUserDefaults.standardUserDefaults.setObject(value, forKey = kidsTrendingKey)
+    }
+}
