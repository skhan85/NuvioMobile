+// MARK: Fork: "What's new in your fork"
+
+/**
+ * Fork: a short note, shown once after an update, listing what's new in this fork. Add an entry
+ * (with a higher id) whenever a fork feature ships; nothing shows until there's an unseen one.
+ */
+internal object ForkWhatsNew {
+    data class Entry(val id: Int, val date: String, val items: List<String>)
+
+    val entries = listOf(
+        Entry(
+            id = 4,
+            date = "Nov 11, 2026",
+            items = listOf(
+                "Style: one choice per profile in Settings > Homescreen replaces the Disney+ switch. Netflix Style, Disney+ Style or Max Style; Custom leaves your own settings alone. A style sets the colours of Home for that profile.",
+            ),
+        ),
+        Entry(
+            id = 3,
+            date = "Nov 6, 2026",
+            items = listOf(
+                "Home cards now tag every non-English title with its language (KOREAN, SPANISH, HINDI…), not just Indian ones.",
+                "The details page shows a title's original language (Korean, Hindi…) in the info line, and the backdrop stays up until a trailer actually starts playing.",
+            ),
+        ),
+        Entry(
+            id = 2,
+            date = "Nov 6, 2026",
+            items = listOf(
+                "Play Something: a shuffle button at the top of Home that resumes something you're watching or plays an unwatched film from your Library or the Top 10.",
+                "Language tags: sources show Hindi, Tamil, Multi-audio and so on, and Indian titles get a HINDI (or Tamil, Telugu…) tag on Home.",
+                "Set a profile's preferred audio language to Hindi (Settings > Playback) and Hindi sources are listed first, so Infuse gets the Hindi file.",
+                "A Remind Me made on the Apple TV now schedules its notification here as soon as it syncs.",
+            ),
+        ),
+        Entry(
+            id = 1,
+            date = "Nov 5, 2026",
+            items = listOf(
+                "Coming Soon row on Home: films streaming in the next 60 days and new series, soonest first. Hold one for Remind Me to get a notification on the day it's out (with Nuvio notifications on).",
+                "Card tags (TOP 10, New Episode, Coming Soon) now show straight away: they're saved between launches and looked up for whole rows ahead.",
+                "Under the hood: the fork's changes are reorganised so Nuvio Enhanced updates break it less often.",
+            ),
+        ),
+    )
+
+    private const val SEEN_KEY = "fork_whats_new_seen"
+
+    fun unseen(): List<Entry> {
+        val seen = runCatching { ForkHomeSettingsStorage.loadForkString(SEEN_KEY)?.toIntOrNull() }.getOrNull() ?: 0
+        return entries.filter { it.id > seen }.sortedByDescending { it.id }.take(3)
+    }
+
+    fun markSeen() {
+        val latest = entries.maxOfOrNull { it.id } ?: return
+        runCatching { ForkHomeSettingsStorage.saveForkString(SEEN_KEY, latest.toString()) }
+    }
+}
+
+@Composable
+internal fun ForkWhatsNewDialog() {
+    var pending by androidx.compose.runtime.remember { androidx.compose.runtime.mutableStateOf(ForkWhatsNew.unseen()) }
+    if (pending.isEmpty()) return
+    val dismiss = {
+        ForkWhatsNew.markSeen()
+        pending = emptyList()
+    }
+    androidx.compose.material3.AlertDialog(
+        onDismissRequest = dismiss,
+        title = { Text("What's new in your Nuvio") },
+        text = {
