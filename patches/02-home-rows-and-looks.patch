+package com.nuvio.app.features.home
+
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.daysUntil
+
+/**
+ * Fork: "Hide unreleased content" also hides films that are only in cinemas so far (nothing to
+ * stream but cam prints). A recent film counts as cinema-only until TMDB lists a digital,
+ * physical or TV release (types 4-6) on or before today. Verdicts come from TMDB in the
+ * background: a film nobody has checked yet stays visible, and [verdicts] changes once it is
+ * checked so Home can filter again. Films whose first release is more than [WINDOW_DAYS] old
+ * are never hidden (TMDB often has no home-release date for older titles).
+ */
+object CinemaOnlyReleases {
+    private const val WINDOW_DAYS = 150
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val gate = Semaphore(4)
+
+    /** Nuvio id -> true when the film is still cinema-only. */
+    private val _verdicts = MutableStateFlow<Map<String, Boolean>>(emptyMap())
+    val verdicts: StateFlow<Map<String, Boolean>> = _verdicts.asStateFlow()
+    private val pending = MutableStateFlow<Set<String>>(emptySet())
+
+    /** True only when TMDB has confirmed the film is still cinema-only. Unchecked films are queued. */
+    fun isCinemaOnly(item: MetaPreview, todayIsoDate: String): Boolean {
+        if (!isCandidate(item, todayIsoDate)) return false
+        _verdicts.value[item.id]?.let { return it }
+        request(item.id)
+        return false
+    }
+
+    /** Checks the candidates in [items] now and waits for the answers (for rows built off-screen). */
+    suspend fun prefetch(items: List<MetaPreview>, todayIsoDate: String) {
+        val ids = items
+            .filter { isCandidate(it, todayIsoDate) && it.id !in _verdicts.value }
+            .map { it.id }
+            .distinct()
+        if (ids.isEmpty()) return
+        coroutineScope {
+            ids.map { id -> async { verify(id, todayIsoDate) } }.awaitAll()
+        }
+    }
+
+    private fun request(id: String) {
+        var added = false
+        pending.update { current ->
+            added = id !in current
+            if (added) current + id else current
+        }
+        if (!added) return
+        scope.launch { verify(id, todayIsoDate = null) }
+    }
+
+    private suspend fun verify(id: String, todayIsoDate: String?) {
+        try {
+            val verdict = gate.withPermit { lookUp(id, todayIsoDate) }
+            _verdicts.update { it + (id to verdict) }
+        } finally {
+            pending.update { it - id }
+        }
+    }
+
+    private suspend fun lookUp(id: String, todayIsoDate: String?): Boolean {
+        val today = parseDay(todayIsoDate ?: CurrentDateProvider.todayIsoDate()) ?: return false
+        // null: TMDB couldn't be reached or the film isn't on TMDB. Don't hide what can't be checked.
+        val releases = runCatching { TmdbMetadataService.forkMovieReleaseDates(id) }.getOrNull() ?: return false
+        val days = releases.mapNotNull { (type, raw) -> parseDay(raw)?.let { type to it } }
+        if (days.isEmpty()) return false
+        val firstRelease = days.minOf { it.second }
+        if (firstRelease > today) return false // not out at all: the date rule already hides it
+        if (firstRelease.daysUntil(today) > WINDOW_DAYS) return false
+        val atHome = days.any { (type, day) -> type >= 4 && day <= today }
+        return !atHome
+    }
+
+    /** Films first released in the last [WINDOW_DAYS] days, or (no full date) this year or last year. */
+    private fun isCandidate(item: MetaPreview, todayIsoDate: String): Boolean {
+        if (!item.type.equals("movie", ignoreCase = true)) return false
+        val today = parseDay(todayIsoDate) ?: return false
+        val released = parseDay(item.rawReleaseDate)
+        if (released != null) {
+            if (released > today) return false
+            return released.daysUntil(today) <= WINDOW_DAYS
+        }
+        val year = (item.rawReleaseDate ?: item.releaseInfo)
+            ?.trim()
+            ?.take(4)
+            ?.toIntOrNull()
+            ?: return false
+        return year == today.year || year == today.year - 1
+    }
+
+    private fun parseDay(raw: String?): LocalDate? {
+        val day = raw?.trim()?.takeIf { it.length >= 10 }?.substring(0, 10) ?: return null
+        return runCatching { LocalDate.parse(day) }.getOrNull()
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt
new file mode 100644
index 00000000..9235afd8
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/home/ForkHomeRows.kt
@@ -0,0 +1,183 @@
+package com.nuvio.app.features.home
+
+import com.nuvio.app.features.catalog.CatalogTarget
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import com.nuvio.app.features.watched.WatchedRepository
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * Fork: extra Netflix-style Home rows built from TMDB, plus the "Remind Me" date check.
+ *  - "Because you watched X": recommendations for the most recently finished titles.
+ *  - "Top 10 Shows Today", "Top 10 Movies Today", "Trending Now": TMDB trending lists
+ *    (the Top 10 rows pick up the big rank numbers because of their names).
+ * Rows come back as ordinary [HomeCatalogSection]s with no "See All" (nothing behind them).
+ */
+object ForkHomeRows {
+    const val BECAUSE_KEY_PREFIX = "fork.because."
+
+    private val mutex = Mutex()
+    private var becauseSignature: String? = null
+    private var becauseRows: List<HomeCatalogSection> = emptyList()
+
+    suspend fun becauseYouWatched(maxRows: Int = 2): List<HomeCatalogSection> {
+        val watched = WatchedRepository.uiState.value.items
+        val seeds = watched
+            .filter { it.type == "movie" || it.type == "series" }
+            .sortedByDescending { it.markedAtEpochMs }
+            .distinctBy { it.id }
+            .take(maxRows)
+        if (seeds.isEmpty()) return emptyList()
+        val signature = seeds.joinToString("|") { it.id }
+        mutex.withLock { if (signature == becauseSignature) return becauseRows }
+
+        val seenIds = watched.map { it.id }.toSet()
+        val seenNames = watched.map { it.name.trim().lowercase() }.toSet()
+        val usedIds = mutableSetOf<String>()
+        val rows = seeds.mapNotNull { seed ->
+            val items = TmdbMetadataService.recommendationsFor(seed.id, seed.type)
+                .filter { it.id !in seenIds && it.name.trim().lowercase() !in seenNames && usedIds.add(it.id) }
+            if (items.size < 4) return@mapNotNull null
+            section(
+                key = BECAUSE_KEY_PREFIX + seed.id,
+                title = "Because you watched ${seed.name}",
+                type = seed.type,
+                items = items,
+            )
+        }
+        mutex.withLock {
+            becauseSignature = signature
+            becauseRows = rows
+        }
+        return rows
+    }
+
+    /** Fork: the TMDB trending rows, refreshed at most every [TRENDING_TTL_MS]. */
+    class TrendingRows(
+        val topShows: HomeCatalogSection?,
+        val topMovies: HomeCatalogSection?,
+        val trendingNow: HomeCatalogSection?,
+    )
+
+    const val TRENDING_KEY_PREFIX = "fork.trending."
+    private const val TRENDING_TTL_MS = 3 * 60 * 60 * 1000L
+    private var trendingRows: TrendingRows? = null
+    private var trendingFetchedAtMs = 0L
+    private var trendingKids = false
+
+    /** [kids]: kid-friendly lists for a kids profile (see [TmdbMetadataService.kidsPopular]). */
+    suspend fun trending(nowEpochMs: Long, kids: Boolean = false): TrendingRows {
+        mutex.withLock {
+            val cached = trendingRows
+            if (cached != null && trendingKids == kids && nowEpochMs - trendingFetchedAtMs < TRENDING_TTL_MS) {
+                return cached
+            }
+            if (trendingKids != kids) {
+                // Never show the other mode's rows (or Top 10 badges) while these load.
+                trendingRows = null
+                trendingKids = kids
+            }
+        }
+        val shows: List<MetaPreview>
+        val movies: List<MetaPreview>
+        val week: List<MetaPreview>
+        if (kids) {
+            val allShows = TmdbMetadataService.kidsPopular("tv")
+            val allMovies = TmdbMetadataService.kidsPopular("movie")
+            shows = allShows.take(10)
+            movies = allMovies.take(10)
+            // Trending Now for kids: the next most popular shows and films, alternating.
+            val moreShows = allShows.drop(10)
+            val moreMovies = allMovies.drop(10)
+            week = (0 until maxOf(moreShows.size, moreMovies.size)).flatMap { i ->
+                listOfNotNull(moreMovies.getOrNull(i), moreShows.getOrNull(i))
+            }
+        } else {
+            shows = TmdbMetadataService.trending("tv", "day").take(10)
+            movies = TmdbMetadataService.trending("movie", "day").take(10)
+            val topIds = (shows + movies).map { it.id }.toSet()
+            week = TmdbMetadataService.trending("all", "week").filter { it.id !in topIds }
+        }
+        // Fork: check which films are still cinema-only before the rows show, so the
+        // "Hide unreleased content" filter on Home doesn't drop them after they appear.
+        if (HomeCatalogSettingsRepository.snapshot().hideUnreleasedContent) {
+            runCatching {
+                CinemaOnlyReleases.prefetch(movies + week, CurrentDateProvider.todayIsoDate())
+            }
+        }
+        fun row(name: String, title: String, type: String, items: List<MetaPreview>, min: Int) =
+            if (items.size < min) null else section(TRENDING_KEY_PREFIX + name, title, type, items)
+        val rows = TrendingRows(
+            topShows = row("top_shows", "Top 10 Shows Today", "series", shows, 5),
+            topMovies = row("top_movies", "Top 10 Movies Today", "movie", movies, 5),
+            trendingNow = row("now", "Trending Now", "movie", week, 6),
+        )
+        // Keep showing the old rows if this refresh came back empty (offline, TMDB down).
+        val usable = rows.topShows != null || rows.topMovies != null || rows.trendingNow != null
+        return mutex.withLock {
+            // The profile switched modes while this loaded: hand back these rows, cache nothing.
+            if (trendingKids != kids) return@withLock rows
+            if (usable || trendingRows == null) {
+                trendingRows = rows
+                trendingFetchedAtMs = if (usable) nowEpochMs else 0L
+            }
+            trendingRows ?: rows
+        }
+    }
+
+    /**
+     * Fork: "#3 in TV Shows Today" for the details page — this title's place in the Top 10 rows
+     * Home last loaded (no network here). Matches TMDB ids directly, else name + year.
+     */
+    fun top10Rank(id: String, name: String, type: String, year: String?): Pair<Int, String>? {
+        val rows = trendingRows ?: return null
+        val isSeries = type.equals("series", true) || type.equals("tv", true)
+        val row = (if (isSeries) rows.topShows else rows.topMovies) ?: return null
+        val wantedName = name.trim().lowercase()
+        val wantedYear = year?.take(4)?.takeIf { it.length == 4 }
+        val index = row.items.indexOfFirst { item ->
+            item.id == id || (
+                item.name.trim().lowercase() == wantedName &&
+                    (wantedYear == null || item.releaseInfo == null || item.releaseInfo.take(4) == wantedYear)
+                )
+        }
+        if (index !in 0..9) return null
+        return (index + 1) to (if (isSeries) "TV Shows" else "Movies")
+    }
+
+    @Throws(Throwable::class)
+    suspend fun becauseYouWatchedChecked(maxRows: Int): List<HomeCatalogSection> = becauseYouWatched(maxRows)
+
+    /** True when the title's release date (yyyy-MM-dd) is after today. */
+    fun isUnreleased(rawReleaseDate: String?, nowEpochMs: Long): Boolean {
+        val date = rawReleaseDate?.takeIf { it.length >= 10 }?.substring(0, 10) ?: return false
+        return date > isoDate(nowEpochMs)
+    }
+
+    private fun section(key: String, title: String, type: String, items: List<MetaPreview>) = HomeCatalogSection(
+        key = key,
+        title = title,
+        subtitle = "",
+        addonName = "TMDB",
+        target = CatalogTarget.Addon(manifestUrl = "", contentType = type, catalogId = key),
+        items = items,
+        availableItemCount = items.size,
+        hasMore = false,
+    )
+
+    /** UTC yyyy-MM-dd for an epoch time (civil-from-days, no datetime library needed). */
+    fun isoDate(epochMs: Long): String {
+        val days = epochMs.floorDiv(86_400_000L)
+        val z = days + 719_468
+        val era = z.floorDiv(146_097L)
+        val doe = z - era * 146_097
+        val yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
+        val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
+        val mp = (5 * doy + 2) / 153
+        val d = doy - (153 * mp + 2) / 5 + 1
+        val m = if (mp < 10) mp + 3 else mp - 9
+        val y = yoe + era * 400 + if (m <= 2) 1 else 0
+        return "${y.toString().padStart(4, '0')}-${m.toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}"
+    }
+}
