+    suspend fun forkFreshness(id: String, type: String): Pair<String?, String?>? {
+        val mediaType = if (type.equals("series", true) || type.equals("tv", true)) "tv" else "movie"
+        val tmdbId = runCatching { TmdbService.ensureTmdbId(id, mediaType) }.getOrNull()
+            ?.toIntOrNull() ?: return null
+        val today = kotlin.time.Clock.System.now()
+            .toLocalDateTime(kotlinx.datetime.TimeZone.currentSystemDefault()).date
+        fun day(raw: String?): kotlinx.datetime.LocalDate? =
+            raw?.takeIf { it.length >= 10 }?.let { runCatching { kotlinx.datetime.LocalDate.parse(it.substring(0, 10)) }.getOrNull() }
+        if (mediaType == "tv") {
+            val show = fetch<ForkTmdbShowAiring>(endpoint = "tv/$tmdbId") ?: return null
+            var primary: String? = null
+            var secondary: String? = null
+            show.last?.let { last ->
+                val aired = day(last.airDate) ?: return@let
+                val daysAgo = aired.daysUntil(today)
+                if (daysAgo in 0..10) {
+                    primary = if (last.episode == 1 && (last.season ?: 1) > 1) "New Season" else "New Episode"
+                }
+            }
+            show.next?.let { next ->
+                val airs = day(next.airDate) ?: return@let
+                val daysAhead = today.daysUntil(airs)
+                if (daysAhead in 0..6) {
+                    if (primary == null && next.episode == 1 && (next.season ?: 1) > 1) primary = "New Season"
+                    if (primary != null) {
+                        secondary = if (daysAhead == 0) "Today"
+                        else airs.dayOfWeek.name.lowercase().replaceFirstChar(Char::uppercase)
+                    }
+                }
+            }
+            if (primary != null && secondary == null) secondary = "Watch Now"
+            return primary to secondary
+        }
+        val releases = fetch<ForkTmdbReleases>(endpoint = "movie/$tmdbId/release_dates") ?: return null
+        // Digital (4) or physical (5): when it became watchable at home.
+        val homeRelease = releases.results
+            .flatMap { it.releaseDates }
+            .filter { (it.type ?: 0) >= 4 }
+            .mapNotNull { day(it.releaseDate) }
+            .minOrNull()
+        if (homeRelease != null && homeRelease.daysUntil(today) in 0..30) return "Recently Added" to null
+        return null to null
+    }
