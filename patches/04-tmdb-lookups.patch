+    suspend fun forkComingSoon(kids: Boolean, limit: Int = 20): List<MetaPreview> = coroutineScope {
+        val language = normalizeTmdbLanguage(TmdbSettingsRepository.snapshot().language)
+        val today = kotlin.time.Clock.System.now()
+            .toLocalDateTime(kotlinx.datetime.TimeZone.currentSystemDefault()).date
+        val tomorrow = today.plus(1, kotlinx.datetime.DateTimeUnit.DAY).toString()
+        val until = today.plus(60, kotlinx.datetime.DateTimeUnit.DAY).toString()
+        val base = mapOf("language" to language, "sort_by" to "popularity.desc", "include_adult" to "false")
+        val movieQuery = base + mapOf(
+            "region" to "US",
+            "with_release_type" to "4|5",
+            "release_date.gte" to tomorrow,
+            "release_date.lte" to until,
+        ) + (if (kids) mapOf("certification_country" to "US", "certification.lte" to "PG", "with_genres" to "10751|16") else emptyMap())
+        val showQuery = base + mapOf(
+            "first_air_date.gte" to tomorrow,
+            "first_air_date.lte" to until,
+        ) + (if (kids) mapOf("with_genres" to "10762|10751") else emptyMap())
+        val moviesDeferred = async { fetch<TmdbRecommendationResponse>(endpoint = "discover/movie", query = movieQuery)?.results.orEmpty() }
+        val showsDeferred = async { fetch<TmdbRecommendationResponse>(endpoint = "discover/tv", query = showQuery)?.results.orEmpty() }
+        val movies = moviesDeferred.await().filter { it.posterPath != null }.take(14)
+        val shows = showsDeferred.await().filter { it.posterPath != null }.take(8)
+        // The streaming date for each film (discover only filters by it; its release_date is the
+        // cinema date). US first, otherwise the earliest anywhere.
+        val movieDates = movies.map { movie ->
+            async {
+                val releases = fetch<ForkTmdbReleases>(endpoint = "movie/${movie.id}/release_dates")?.results.orEmpty()
+                fun homeDays(countries: List<ForkTmdbReleaseCountry>) = countries
+                    .flatMap { it.releaseDates }
+                    .filter { (it.type ?: 0) >= 4 }
+                    .mapNotNull { it.releaseDate?.take(10) }
+                    .filter { it >= tomorrow }
+                    .sorted()
+                // Fork: already watchable at home somewhere (any country), or in cinemas more than
+                // 90 days ago: it's out, so it isn't Coming Soon.
+                val all = releases.flatMap { it.releaseDates }
+                val todayText = today.toString()
+                val cutoff = today.minus(90, kotlinx.datetime.DateTimeUnit.DAY).toString()
+                val alreadyOut = all.any { (it.type ?: 0) >= 4 && (it.releaseDate?.take(10) ?: "9999") <= todayText } ||
+                    all.any { (it.type ?: 0) in 2..3 && (it.releaseDate?.take(10) ?: "9999") < cutoff }
+                if (alreadyOut) return@async movie to null
+                movie to (homeDays(releases.filter { it.country == "US" }).firstOrNull() ?: homeDays(releases).firstOrNull())
+            }
+        }.awaitAll()
+        fun preview(item: TmdbRecommendationItem, type: String, date: String): MetaPreview? {
+            val title = listOf(item.title, item.name, item.originalTitle, item.originalName)
+                .firstNotNullOfOrNull { it?.trim()?.takeIf(String::isNotBlank) } ?: return null
+            return MetaPreview(
