+        val dated = movieDates.mapNotNull { (movie, date) -> date?.let { d -> preview(movie, "movie", d)?.let { d to it } } } +
+            shows.mapNotNull { show ->
+                show.firstAirDate?.take(10)?.takeIf { it >= tomorrow }?.let { d -> preview(show, "series", d)?.let { d to it } }
+            }
