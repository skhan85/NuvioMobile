+/** Fork: TMDB list items → previews for the Top 10 / Trending rows (people dropped). */
+private fun forkMapTrending(results: List<TmdbRecommendationItem>, mediaType: String): List<MetaPreview> =
+    results
+        .filter { it.id > 0 }
+        .mapNotNull { item ->
+            val type = when (item.mediaType?.lowercase() ?: mediaType) {
+                "tv" -> "series"
+                "movie" -> "movie"
+                else -> return@mapNotNull null // people in the "all" list
+            }
+            val title = listOf(item.title, item.name, item.originalTitle, item.originalName)
+                .firstNotNullOfOrNull { it?.trim()?.takeIf(String::isNotBlank) }
+                ?: return@mapNotNull null
+            MetaPreview(
+                id = "tmdb:${item.id}",
+                type = type,
+                name = title,
+                poster = buildImageUrl(item.posterPath, "w500")
+                    ?: buildImageUrl(item.backdropPath, "w780"),
+                banner = buildImageUrl(item.backdropPath, "w1280"),
+                posterShape = PosterShape.Poster,
+                description = item.overview?.trim()?.takeIf(String::isNotBlank),
+                releaseInfo = (item.releaseDate ?: item.firstAirDate)?.take(4),
+                rawReleaseDate = item.releaseDate ?: item.firstAirDate,
+                imdbRating = item.voteAverage?.formatRating(),
+            )
+        }
