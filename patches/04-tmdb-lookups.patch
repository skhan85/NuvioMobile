+        val cinema = releases.results
+            .flatMap { it.releaseDates }
+            .filter { (it.type ?: 0) in 2..3 }
+            .mapNotNull { day(it.releaseDate) }
+            .minOrNull()
+        if (cinema != null && cinema.daysUntil(today) > 90) return Triple(null, null, language)
+        // Fork: streaming soon — "Coming Soon" with the day (this week) or the date.
+        val upcoming = releases.results
+            .flatMap { it.releaseDates }
+            .filter { (it.type ?: 0) >= 4 }
