+        fun day(raw: String?): kotlinx.datetime.LocalDate? =
+            raw?.takeIf { it.length >= 10 }?.let { runCatching { kotlinx.datetime.LocalDate.parse(it.substring(0, 10)) }.getOrNull() }
+        if (mediaType == "tv") {
+            val show = fetch<ForkTmdbShowAiring>(endpoint = "tv/$tmdbId") ?: return null
+            var primary: String? = null
+            var secondary: String? = null
+            show.last?.let { last ->
+                val aired = day(last.airDate) ?: return@let
+                val daysAgo = aired.daysUntil(today)
+                if (daysAgo in 0..10) {
+                    primary = if (last.episode == 1 && (last.season ?: 1) > 1) "New Season" else "New Episode"
+                }
+            }
+            show.next?.let { next ->
+                val airs = day(next.airDate) ?: return@let
+                val daysAhead = today.daysUntil(airs)
+                // Fork: a show premiering (or a new season starting) later on: "Coming Soon" /
+                // "New Season" with the date.
+                if (primary == null && daysAhead in 7..60 && next.episode == 1) {
+                    val premiere = show.last == null || (next.season ?: 1) <= 1
+                    return Triple(if (premiere) "Coming Soon" else "New Season", forkShortDate(airs), show.originalLanguage)
+                }
+                if (daysAhead in 0..6) {
+                    if (primary == null && next.episode == 1 && (next.season ?: 1) > 1) primary = "New Season"
+                    if (primary != null) {
+                        secondary = if (daysAhead == 0) "Today"
+                        else airs.dayOfWeek.name.lowercase().replaceFirstChar(Char::uppercase)
+                    }
+                }
+            }
+            if (primary != null && secondary == null) secondary = "Watch Now"
+            return Triple(primary, secondary, show.originalLanguage)
+        }
+        // Fork: the details (for the original language) with the release dates in one call.
+        val movie = fetch<ForkTmdbMovieReleases>(
+            endpoint = "movie/$tmdbId",
+            query = mapOf("append_to_response" to "release_dates"),
+        ) ?: return null
+        val releases = movie.releaseDates ?: ForkTmdbReleases()
+        val language = movie.originalLanguage
+        // Digital (4) or physical (5): when it became watchable at home.
+        val homeRelease = releases.results
+            .flatMap { it.releaseDates }
+            .filter { (it.type ?: 0) >= 4 }
+            .mapNotNull { day(it.releaseDate) }
+            .minOrNull()
+        // Fork: already out at home somewhere (any country): "Recently Added" for a month, then
+        // nothing. Never "Coming Soon" just because a later date (another country, a disc) is ahead.
+        if (homeRelease != null && homeRelease.daysUntil(today) >= 0) {
+            return Triple(if (homeRelease.daysUntil(today) <= 30) "Recently Added" else null, null, language)
