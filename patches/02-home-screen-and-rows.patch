+
+/** Fork: one Like / Not interested vote (see [ForkTitleFeedback]). */
+@Serializable
+data class ForkFeedbackEntry(
+    val id: String,
+    val name: String,
+    val type: String,
+    /** [ForkTitleFeedback.LIKED] or [ForkTitleFeedback.NOT_INTERESTED]. */
+    val value: Int,
+    val atEpochMs: Long,
+)
+
+/**
+ * Fork: thumbs up / down per title, from the Rate button on the details page (idea from Notflix).
+ * Per profile, device-local (`fork_title_feedback_<profile index>`).
+ *  - Liked titles get a "Because you liked …" row on Home, and titles TMDB recommends for them
+ *    move to the front of the other "Because you watched" rows.
+ *  - "Not interested" titles leave the Because rows, Coming Soon and Play Something, never start
+ *    a Because row, and titles TMDB finds similar to one sink to the end of the Because rows.
+ */
+object ForkTitleFeedback {
+    const val LIKED = 1
+    const val NOT_INTERESTED = -1
+    private const val MAX_ENTRIES = 300
+    private const val KEY_PREFIX = "fork_title_feedback_"
+
+    private val json = Json { ignoreUnknownKeys = true }
+    private val _entries = MutableStateFlow<List<ForkFeedbackEntry>>(emptyList())
+    /** The active profile's votes, newest first. */
+    val entries: StateFlow<List<ForkFeedbackEntry>> = _entries.asStateFlow()
+    private var loadedProfile: Int? = null
+
+    private fun activeProfile(): Int =
+        runCatching { ProfileRepository.state.value.activeProfile?.profileIndex }.getOrNull() ?: 1
+
+    /** Loads the active profile's votes (again after a profile switch). */
+    fun ensureLoaded(profileIndex: Int = activeProfile()) {
+        if (loadedProfile == profileIndex) return
+        loadedProfile = profileIndex
+        val raw = ForkHomeSettingsStorage.loadForkString(KEY_PREFIX + profileIndex)
+        _entries.value = raw?.let {
+            runCatching { json.decodeFromString<List<ForkFeedbackEntry>>(it) }.getOrNull()
+        } ?: emptyList()
+    }
+
+    /** The ids a title can appear under ("tt123:1:2" also matches "tt123"). */
+    private fun key(id: String): String =
+        if (id.startsWith("tt")) id.substringBefore(':') else id
+
+    fun valueFor(id: String): Int? {
+        ensureLoaded()
+        val k = key(id)
+        return _entries.value.firstOrNull { key(it.id) == k }?.value
+    }
+
+    fun set(id: String, name: String, type: String, value: Int?) {
+        val profile = activeProfile()
+        ensureLoaded(profile)
+        val k = key(id)
+        val kept = _entries.value.filterNot { key(it.id) == k }
+        val updated = (if (value == null) kept else {
+            listOf(ForkFeedbackEntry(id, name, type, value, WatchProgressClock.nowEpochMs())) + kept
+        }).take(MAX_ENTRIES)
+        _entries.value = updated
+        ForkHomeSettingsStorage.saveForkString(KEY_PREFIX + profile, json.encodeToString(updated))
+    }
+
+    fun liked(entries: List<ForkFeedbackEntry>): List<ForkFeedbackEntry> = entries.filter { it.value == LIKED }
+    fun notInterested(entries: List<ForkFeedbackEntry>): List<ForkFeedbackEntry> =
+        entries.filter { it.value == NOT_INTERESTED }
+
+    fun notInterestedKeys(entries: List<ForkFeedbackEntry>): Set<String> =
+        notInterested(entries).mapTo(mutableSetOf()) { key(it.id) }
+
+    fun isNotInterested(id: String, entries: List<ForkFeedbackEntry> = _entries.value): Boolean =
+        key(id) in notInterestedKeys(entries)
+
+    /** Drops the titles marked "Not interested". */
+    fun visible(items: List<MetaPreview>, entries: List<ForkFeedbackEntry> = _entries.value): List<MetaPreview> {
+        val hidden = notInterestedKeys(entries)
+        if (hidden.isEmpty()) return items
+        return items.filterNot { key(it.id) in hidden }
+    }
+
+    internal fun matches(a: String, b: String): Boolean = key(a) == key(b)
+}
