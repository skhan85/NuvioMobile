+private const val BROWSING_CLOSES_ESTIMATE_MS = 60_000L
+private const val AWAY_STRETCH_MARGIN_MS = 30L * 60_000L
+private const val ESTIMATE_WINDOW_MS = 6L * 60L * 60_000L
+private const val MIN_ESTIMATE_AWAY_MS = 2L * 60_000L
+private const val ESTIMATE_SETBACK_MIN_MS = 60_000L
+// Below Nuvio's 90% watched threshold and the 80% at which trackers such as Simkl count a play.
+private const val ESTIMATE_CAP_FRACTION = 0.79
