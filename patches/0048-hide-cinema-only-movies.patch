+    /**
+     * Fork: every TMDB release of a film as (type, yyyy-MM-dd…) pairs, all countries — 1 premiere,
+     * 2 limited theatrical, 3 theatrical, 4 digital, 5 physical, 6 TV. Null when the film can't be
+     * matched on TMDB or TMDB can't be reached (see CinemaOnlyReleases).
+     */
+    suspend fun forkMovieReleaseDates(id: String): List<Pair<Int, String>>? {
+        val tmdbId = runCatching { TmdbService.ensureTmdbId(id, "movie") }.getOrNull()
+            ?.toIntOrNull() ?: return null
+        val releases = fetch<ForkTmdbReleases>(endpoint = "movie/$tmdbId/release_dates") ?: return null
+        return releases.results
+            .flatMap { it.releaseDates }
+            .mapNotNull { release ->
+                val type = release.type ?: return@mapNotNull null
+                val date = release.releaseDate?.takeIf { it.length >= 10 } ?: return@mapNotNull null
+                type to date
+            }
+    }
+
