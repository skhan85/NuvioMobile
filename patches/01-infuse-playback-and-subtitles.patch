+/**
+ * Fork: the More Like This card for movies played in an external player (Infuse).
+ *
+ * Nuvio's own player shows the card during the last two minutes of a movie. Infuse plays the movie
+ * itself, so instead the card appears when Infuse hands back to Nuvio near the end: inside that
+ * window, or past 90% (where people tend to stop once the credits roll, and where Nuvio counts the
+ * movie as watched). Uses the same Movie Recommendations setting.
+ */
+internal object ExternalMovieSuggestions {
+    private val pendingMovie = MutableStateFlow<WatchProgressPlaybackSession?>(null)
+    val pending = pendingMovie.asStateFlow()
+
+    fun onExternalPlaybackReturned(result: ExternalPlaybackResult, fallbackSession: WatchProgressPlaybackSession?) {
+        val session = result.playbackSession ?: fallbackSession ?: return
+        if (session.parentMetaType != "movie" && session.contentType != "movie") return
+        PlayerSettingsRepository.ensureLoaded()
+        if (!PlayerSettingsRepository.uiState.value.movieRecommendationsEnabled) return
+        val durationMs = result.durationMs?.takeIf { it > 0L }
+        val reachedEnd = !result.endedByUser ||
+            (durationMs != null && result.positionMs >= durationMs * 9 / 10) ||
+            (durationMs != null &&
+                PlayerNextEpisodeRules.movieRecommendationStage(
+                    positionMs = result.positionMs,
+                    durationMs = durationMs,
+                    isEnded = false,
+                ) > 0)
+        if (reachedEnd) pendingMovie.value = session
+    }
+
+    fun dismiss() {
+        pendingMovie.value = null
+    }
+}
+
+private const val EXTERNAL_SUGGESTION_LIMIT = 10
+
+/** Shows the card over the whole app; place it inside the root Box. */
+@Composable
+internal fun ExternalMovieSuggestionsOverlay(
+    onOpen: (MetaPreview) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val movie by ExternalMovieSuggestions.pending.collectAsStateWithLifecycle()
+    val watchedUiState by remember {
+        WatchedRepository.ensureLoaded()
+        WatchedRepository.uiState
+    }.collectAsStateWithLifecycle()
+    var suggestions by remember { mutableStateOf<List<MetaPreview>>(emptyList()) }
+
+    LaunchedEffect(movie?.parentMetaId) {
+        val current = movie ?: run {
+            suggestions = emptyList()
+            return@LaunchedEffect
+        }
+        val meta = MetaDetailsRepository.peek(current.parentMetaType, current.parentMetaId)
+            ?.takeIf { it.moreLikeThis.isNotEmpty() }
+            ?: runCatching { MetaDetailsRepository.fetch(current.parentMetaType, current.parentMetaId) }.getOrNull()
+        suggestions = meta?.moreLikeThis.orEmpty()
+        if (suggestions.isEmpty()) ExternalMovieSuggestions.dismiss()
+    }
+
+    val current = movie
+    val visibleSuggestions = remember(suggestions, watchedUiState.watchedKeys, current?.parentMetaId) {
+        suggestions.asSequence()
+            .filterNot { it.id == current?.parentMetaId }
+            .filterNot { WatchingState.isPosterWatched(watchedKeys = watchedUiState.watchedKeys, item = it) }
+            .take(EXTERNAL_SUGGESTION_LIMIT)
+            .toList()
+    }
+
+    MovieRecommendationCard(
+        recommendations = visibleSuggestions,
+        // Fork: back from Infuse at the end of a movie counts as "ended": the card stays up
+        // until dismissed (Enhanced's card takes a stage instead of a visible flag).
+        stage = if (current != null && visibleSuggestions.isNotEmpty()) {
+            PlayerNextEpisodeRules.MOVIE_RECOMMENDATION_STAGE_ENDED
+        } else {
+            0
+        },
+        dismissed = false,
+        controlsVisible = false,
+        onOpen = { preview ->
+            ExternalMovieSuggestions.dismiss()
+            onOpen(preview)
+        },
+        onDismiss = ExternalMovieSuggestions::dismiss,
+        modifier = modifier
+            .windowInsetsPadding(WindowInsets.safeDrawing)
+            .padding(end = 16.dp, bottom = 88.dp),
+    )
+}
