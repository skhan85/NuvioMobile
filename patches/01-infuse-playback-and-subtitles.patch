@@ -0,0 +1,48 @@
+package com.nuvio.app.features.player
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.darwin.Darwin
+import io.ktor.client.plugins.HttpTimeout
+import io.ktor.client.request.head
+import io.ktor.http.HttpHeaders
+import io.ktor.http.URLBuilder
+import io.ktor.http.takeFrom
+import kotlinx.coroutines.withTimeoutOrNull
+
+private val redirectProbeClient = HttpClient(Darwin) {
+    followRedirects = false
+    expectSuccess = false
+    install(HttpTimeout) {
+        requestTimeoutMillis = 4_000
+        connectTimeoutMillis = 4_000
+    }
+}
+
+private const val MAX_REDIRECT_HOPS = 5
+
+/**
+ * HEAD requests only (no body is downloaded); at most five hops and five seconds. The resolved link
+ * is used only when the chain ends in a 2xx answer; anything else keeps the original link.
+ */
+internal actual suspend fun resolveExternalStreamUrl(url: String): String {
+    if (!url.startsWith("http://") && !url.startsWith("https://")) return url
+    return withTimeoutOrNull(5_000L) {
+        var current = url
+        repeat(MAX_REDIRECT_HOPS) {
+            val response = runCatching { redirectProbeClient.head(current) }.getOrNull() ?: return@withTimeoutOrNull url
+            when (response.status.value) {
+                // Only a link that answered OK is handed over.
+                in 200..299 -> return@withTimeoutOrNull current
+                in 300..399 -> {
+                    val location = response.headers[HttpHeaders.Location]?.takeIf { it.isNotBlank() }
+                        ?: return@withTimeoutOrNull url
+                    current = runCatching { URLBuilder(current).takeFrom(location).buildString() }.getOrNull()
+                        ?: return@withTimeoutOrNull url
+                }
+                // A hop that refuses HEAD (TorBox answers 400) or fails: Infuse gets the original link.
+                else -> return@withTimeoutOrNull url
+            }
+        }
+        url
+    } ?: url
+}
