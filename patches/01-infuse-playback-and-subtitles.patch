@@ -0,0 +1,47 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.watchprogress.WatchProgressClock
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/**
+ * Fork: "warm the stream before you press Play" (from ysosrs123's NuvioTV fork). The stream list
+ * resolves the top links' redirect chains in the background as soon as they appear, so the debrid
+ * service unlocks the file early and pressing Play hands Infuse the final link with no wait.
+ * Results are kept for five minutes. Only links without addon-declared headers are warmed (the
+ * same rule the launch-time redirect resolution uses).
+ */
+internal object StreamWarmup {
+    private const val KeepMs = 5 * 60 * 1000L
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val mutex = Mutex()
+    private val resolved = mutableMapOf<String, Pair<String, Long>>()
+    private val inFlight = mutableMapOf<String, Deferred<String>>()
+
+    fun warm(url: String) {
+        if (!url.startsWith("http://") && !url.startsWith("https://")) return
+        scope.launch { runCatching { resolve(url) } }
+    }
+
+    /** The link [url]'s redirect chain ends at — from the warm-up cache when it is fresh. */
+    suspend fun resolve(url: String): String {
+        val now = WatchProgressClock.nowEpochMs()
+        val pending = mutex.withLock {
+            resolved[url]?.let { (target, at) -> if (now - at < KeepMs) return target }
+            inFlight.getOrPut(url) { scope.async { resolveExternalStreamUrl(url) } }
+        }
+        val target = runCatching { pending.await() }.getOrDefault(url)
+        mutex.withLock {
+            inFlight.remove(url)
+            if (target != url) resolved[url] = target to WatchProgressClock.nowEpochMs()
+            if (resolved.size > 50) resolved.keys.take(resolved.size - 50).forEach(resolved::remove)
+        }
+        return target
+    }
+}
