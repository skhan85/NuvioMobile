+/**
+ * Fork: Netflix's Continue Watching card — poster with a round play button, "S3:E24" over a red
+ * progress bar at the bottom edge, and ⓘ (details) and ⋮ (more) under it.
+ */
+@Composable
+private fun ForkNetflixContinueCard(
+    item: ContinueWatchingItem,
+    layout: ContinueWatchingLayout,
+    useEpisodeThumbnails: Boolean,
+    blurNextUp: Boolean,
+    onClick: (() -> Unit)?,
+    onLongClick: (() -> Unit)?,
+) {
+    val cornerRadius = rememberPosterCardStyleUiState().cornerRadiusDp.dp
+    val imageUrl = item.continueWatchingPosterArtworkUrl(false)
+    val shape = RoundedCornerShape(cornerRadius)
+    Column(
+        modifier = Modifier
+            .width(layout.posterCardWidth)
+            .clip(shape)
+            .background(MaterialTheme.colorScheme.surfaceVariant),
+    ) {
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(layout.posterCardHeight)
+                .posterCardClickable(
+                    onClick = onClick,
+                    onLongClick = onLongClick,
+                    zoomImageUrl = imageUrl,
+                    zoomCornerRadius = cornerRadius,
+                ),
+        ) {
+            if (imageUrl != null) {
+                AsyncImage(
+                    model = continuewatchingImageModel(
+                        imageUrl = cloudLibraryDisplayArtworkUrl(imageUrl),
+                        fallbackUrl = item.fallbackUrlForArtwork(imageUrl),
+                    ),
+                    contentDescription = item.title,
+                    modifier = Modifier.fillMaxSize(),
+                    contentScale = if (item.isCloudLibraryItem()) ContentScale.Fit else ContentScale.Crop,
+                )
+            }
+            // Gentle scrim so the label and button read over bright art.
+            Box(
+                modifier = Modifier
+                    .matchParentSize()
+                    .background(
+                        androidx.compose.ui.graphics.Brush.verticalGradient(
+                            0.55f to Color.Transparent,
+                            1f to Color.Black.copy(alpha = 0.7f),
+                        ),
+                    ),
+            )
+            val upcoming = item.progressFraction <= 0f && !item.isReleaseAlert &&
+                computeAirDateBadgeText(item.released, CurrentDateProvider.todayIsoDate()) != null
+            if (!upcoming) {
+                com.nuvio.app.features.home.ForkPlayCircle(
+                    size = (layout.posterCardWidth * 0.42f),
+                    modifier = Modifier.align(Alignment.Center),
+                )
+            }
+            if (item.isReleaseAlert || upcoming) {
+                val badge = when {
+                    item.isNewSeasonRelease -> stringResource(Res.string.cw_new_season)
+                    item.isReleaseAlert -> stringResource(Res.string.cw_new_episode)
+                    else -> computeAirDateBadgeText(item.released, CurrentDateProvider.todayIsoDate()).orEmpty()
+                }
+                Text(
+                    text = badge,
+                    color = Color.White,
+                    fontSize = 9.sp,
+                    fontWeight = FontWeight.Bold,
+                    maxLines = 1,
+                    modifier = Modifier
+                        .align(Alignment.TopCenter)
+                        .padding(top = 6.dp)
+                        .clip(RoundedCornerShape(2.dp))
+                        .background(com.nuvio.app.features.home.ForkNetflixHome.NetflixRed)
+                        .padding(horizontal = 5.dp, vertical = 2.dp),
+                )
+            }
+            val label = if (item.seasonNumber != null && item.episodeNumber != null) {
+                "S${item.seasonNumber}:E${item.episodeNumber}"
+            } else {
+                null
+            }
+            if (label != null) {
+                Text(
+                    text = label,
+                    color = Color.White,
+                    style = MaterialTheme.typography.labelLarge.copy(fontWeight = FontWeight.Bold),
+                    modifier = Modifier
