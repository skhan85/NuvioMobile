+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.details.MetaEpisodeCardStyle
+import com.nuvio.app.features.details.MetaScreenSectionKey
+import com.nuvio.app.features.details.MetaScreenSettingsRepository
+import com.nuvio.app.features.details.MetaScreenSettingsUiState
+import com.nuvio.app.features.home.ForkHomeSettings
+
+/** Fork: the tab the Netflix look puts Episodes / More Like This / Trailers in. */
+private const val NetflixTabGroup = 1
+private val NetflixTabbedSections = listOf(
+    MetaScreenSectionKey.EPISODES,
+    MetaScreenSectionKey.MORE_LIKE_THIS,
+    MetaScreenSectionKey.TRAILERS,
+)
+
+/**
+ * Fork: one tap to make the details page look like Netflix, using the page's own settings —
+ * trailer playing in the header, full-width Play with icon buttons under it, Episodes / More Like
+ * This / Trailers as tabs, wide episode cards — plus the fork's white Play button. Everything
+ * stays adjustable below. Also the switch for the white Play button on its own.
+ */
+@Composable
+internal fun ForkNetflixDetailsSettings(isTablet: Boolean, uiState: MetaScreenSettingsUiState) {
+    val whitePlay by remember {
+        ForkHomeSettings.ensureLoaded()
+        ForkHomeSettings.whitePlayButton
+    }.collectAsStateWithLifecycle()
+    SettingsNavigationRow(
+        title = "Netflix Style",
+        description = "Trailer in the header, white Play button, Episodes / More Like This / Trailers as tabs",
+        isTablet = isTablet,
+        onClick = { applyNetflixDetailsLook(uiState) },
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsSwitchRow(
+        title = "White Play Button",
+        description = "A white Play button like Netflix, instead of your theme colour",
+        checked = whitePlay,
+        isTablet = isTablet,
+        onCheckedChange = ForkHomeSettings::setWhitePlayButton,
+    )
+}
+
+private fun applyNetflixDetailsLook(uiState: MetaScreenSettingsUiState) {
+    MetaScreenSettingsRepository.setHeroTrailerPlayback(true)
+    MetaScreenSettingsRepository.setIconActionRow(true)
+    MetaScreenSettingsRepository.setEpisodeCardStyle(MetaEpisodeCardStyle.Horizontal)
+    // Free the tab for the three Netflix sections (a tab holds at most three).
+    uiState.items
+        .filter { it.tabGroup == NetflixTabGroup && it.key !in NetflixTabbedSections }
+        .forEach { MetaScreenSettingsRepository.setTabGroup(it.key, null) }
+    NetflixTabbedSections.forEach { key ->
+        MetaScreenSettingsRepository.setEnabled(key, true)
+        MetaScreenSettingsRepository.setTabGroup(key, NetflixTabGroup)
+    }
+    MetaScreenSettingsRepository.setTabLayout(true)
+    ForkHomeSettings.setWhitePlayButton(true)
+}
